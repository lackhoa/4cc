[The mutual exclusion problem: Alice and Bob' pet
 [NOTE This is Alice's and Bob's "main loop"
  {
   global b32 Alice_flag;
   global b32 Bob_flag;
   
   function void
   Alice_main()
   {
    while(1)
    {
     if(Alice_wants_to_go)
     {
      Alice_raise:
      Alice_flag = 1;
      
      Alice_wait:
      wait_until(Bob_flag == 0);
      
      Alice_go();
      
      Alice_flag = 0;
     }
    }
   }
   
   function void
   Bob_main()
   {
    while(1)
    {
     // NOTE At this point, Bob's flag is always lowered
     if(Bob_wants_to_go)
     {
      Bob_raise:
      Bob_flag = 1;
      
      Bob_check:
      if(Alice_flag == 1)
      {// NOTE Give priority for Alice
       Bob_flag = 0;
       
       wait_until(Alice_flag == 0);
      }
      else
      {// Note Go
       Bob_go();
       
       Bob_flag = 0;
      }
     }
    }
   }
  }
  
  [NOTE There could be an arbitrary finite delay between steps,
   f.ex one of them is absent from home, or emergencies come up]
  ]
 
