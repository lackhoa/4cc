[// ;project_point_onto_plane How to project a point onto a plane?
 // The plane equation is
 {
  a x + b y + c z + d = 0
 }
 // In English: plug (x,y,z) in that equation, the point is on the plane
 // iff that equation evaluates to 0.
 
 // Or, if we say that the normal "n = (a,b,c)", we have a better form
 {
  dot(n, (x,y,z)) + d = 0
 }
 // This form is concise, but the other one shows how you can derive it from
 // remembering that 3D planes are just one linear equation.
 
 // Let's also assume that the normal is... normalized,
 // you could just adjust "d" if it's not.
 n_is_normalized
 
 [// Suppose we have some point "P", its projection "Q" on the plane is found by
  // casting a ray along the plane's normal,
  // where it hits the plane will be the projection.
  Q = P + t n
  
  // "Q" is on the plane, so it has to satisfy this equation
  dot(n, Q) + d = 0
  
  Combining the equations gives
  {
   dot(n, P + t n) + d = 0
   dot(n, P) + dot(n, t n) + d = 0
   dot(n, P) + t dot(n, n) + d = 0
   dot(n, P) + t + d = 0          [n_is_normalized]
   t = -(d + dot(n, P))           // (Which kinda looks like the plane equation)
   
   distance = absolute(d + dot(n, P))
  }
  ]
 ]

[// ;ray_intersects_plane
 // So there's this ray described by the tuple,
 ray = (ray_P, ray_dir)
 
 // And a plane described by
 plane = (n, d)
 
 Let's say the ray hits the plane at the point {Q} (NOTE if it ever does, it may not)
 Since {Q} belongs to the ray
 {
  Q = ray_P + t ray_dir
 }
 {Q} also belongs to the plane
 {
  dot(n, Q) + d = 0;
  dot(n, ray_P + t ray_dir) + d = 0;
  dot(n, ray_P) + t dot(n, ray_dir) + d = 0;
  t = -(d + dot(n, ray_P)) / dot(n, ray_dir);
 }
 ]

[;cramers_rule
