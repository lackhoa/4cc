//-
// NOTE(kv) "Basic types" are used to compose other introspected types.
// For example, if you wanna print "struct Foo{ String name; v1 value; };"
// you need only know how to print "String", "v1", same with serialization and reads.
//-
meta_table(T) basic_types
{
 v1, v2, v3, v4,
 i1, i2, i3, i4,
 String, u32, u64,
}

generate
{
 enum Basic_Type
 {
  Basic_Type_None = 0,
  gen_for(basic_types)
  {
   Basic_Type_`T,
  }
  Basic_Type_Count,
 };
 
 gen_for(basic_types)
 {
  function Basic_Type
   basic_type_from_pointer(`T *pointer)
  {
   return Basic_Type_`T;
  }
 }
}

gen_file "basic_types_read.gen.h"
{
 function void
  read_binary_String(Binary_Reader *r, String *dst)
 {
  read_binary_size(r, sizeof(u32), &dst->count);
  //NOTE(kv) ultra piggy! Just point to the file!
  dst->str = r->pos;
  
  if(r->end_pos - r->pos < isize(dst->count)){
   r->ok = false;
  }
  if(r->ok){
   r->pos += dst->count;
  }
 }
 
 gen_for(basic_types except(String))
 {
  myinline void
   read_binary_`T(Binary_Reader *r, `T *dst)
  {
   read_binary_size(r, sizeof(`T), dst);
  }
  
  myinline `T
   read_binary_`T(Binary_Reader *r)
  {
   `T dst;
   read_binary_size(r, sizeof(`T), &dst);
   return dst;
  }
 }
}

gen_file "basic_types_info.gen.h"
{
 gen_for(basic_types)
 {
  global Type_Info Type_Info_`T =
  {
   .name=strlit(`quotes(T)),
   .size=i1(sizeof(`T)),
   .kind=I_Type_Kind_Basic,
   .Basic_Type=Basic_Type_`T,
  };
 }
 
 global Type_Info dummy_type_info;
 
 global Type_Info *basic_types_info[Basic_Type_Count+1] =
 {
  &dummy_type_info,
  gen_for(basic_types)
  {
   &Type_Info_`T,
  }
 };
 
#define Type_Info_i32   Type_Info_i1
#define read_binary_i32 read_binary_i1
}
//-