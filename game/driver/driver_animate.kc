function void
test_slider_multiple_files()
{
 DEBUG_VALUE(fv(3));
}
function Reference_Preset_Data
driver_get_reference_preset_data(Reference_Preset preset);

function void
movie_shot_blinking(Movie_Shot *shot)
{
 aset(teye_phi2, 3);
 arest(8);
 aset(teye_phi2, -2);
 arest(1);
 aset(teye_phi2, -3);
 arest(4);
 
 aset(tblink, 1);
 arest(1);
 aset(tblink, 6);
 arest(1);
 aset(tblink, 6);
 arest(1);
 aset(tblink, 1);
 aset(teye_phi2, 0);
 arest(1);
 aset(tblink, 0);
 arest(12);
}
function void
movie_shot_arm(Movie_Shot *shot)
{
 asetf(tarm_abduct, 0.0211f);
 if(0)
 {
  aset(tarm_bend, 11);
 }
 arest(6);
}
function void
blink_2_frames(Movie_Shot *shot)
{
 aset(tblink, 1);
 arest(1);
 aset(tblink, 6);
 arest(1);
}
function void
open_eyes(Movie_Shot *shot)
{
 aset(tblink,0);
}
function void
movie_shot_head_tilt(Movie_Shot *shot)
{
 {// NOTE: right tilt
  aset(thead_phi2, 0);
  arest(2);
  blink_2_frames(shot);
  
  aset(thead_phi2, 1);
  arest(1);
  
  aset(thead_phi2, -6);
  open_eyes(shot);
  arest(6);
 }
 {// NOTE: up tilt
  aset(thead_theta2, -1);
  arest(1);
  aset(thead_theta2, -2);
  arest(6);
  blink_2_frames(shot);
 }
 {// NOTE: left tilt
  aset(thead_phi2, -8);
  aset(thead_theta2,   -3);
  arest(1);
  aset(thead_phi2, -7);
  aset(thead_theta2,   0);
  arest(1);
  aset(thead_phi2, 4);  // NOTE: Need this in-between, otw it feels really jerky!
  open_eyes(shot);
  arest(1);
 }
 aset(thead_phi2, 6); // rest
 arest(8);
}
function Pose
driver_animate(v1 anim_time)
{
 Movie_Shot shot_value = {};
 Movie_Shot *shot = &shot_value;
 shot->anime_time = anim_time;
 // NOTE(kv) Can't live without my blink animation, man!
 b32 do_blink = true;
 
 Reference_Preset preset = get_reference_preset();
 if(preset != 0)
 {//-Has preset -> fix the pose
  shot->out_pose = driver_get_reference_preset_data(preset).pose;
 }
 else
 {// ;set_movie_shot
  i32 sel = fv(1);
  if(0);
  else if(sel == 0)
  {
   do_blink = false;
   shot_go(shot, movie_shot_head_tilt);
  }
  else if(sel == 1)
  {// NOTE Test playing two animations simultaneously.
   shot_go(shot, movie_shot_arm);
  }
 }
 
 if(do_blink)
 {
  shot_go(shot, movie_shot_blinking);
 }
 
 Pose pose = shot->out_pose;
 return pose;
}

