function void
driver_update_tweaks()
{// NOTE @driver_api
 {// See @Tweak_Variables
  // NOTE(kv) This shouldn't be folded into "driver_update"
  // because it's stateless and we wanna call it first-thing in the frame!
  tweaks->focal_length = fv(i1_2) * 0.25f;  // NOTE(kv) The realistic focal length is "0.6f"
  tweaks->background_rgb = fv(v1_3) * V3(1,1,1);
  tweaks->force_stamp_rendering = fv(i1_4);
  tweaks->ignore_lightness_additions = fv(i1_5);
  tweaks->stamp_density_mult   = v1(fv(i1_6));
  tweaks->stamp_rotation_speed = v1(fv(i1_7));
  tweaks->cull_curve = fbool(i1_8);
 }
 
 {//-driver
  fpreset(Preset_None);
  show_skeleton = fbool(i1_9);
 }
}
function void
crappy_tests(v1 anim_time)
{
 if(fbool(i1_10))
 {
  v1 x = 96.f;
  tvert a = fv(tvert_11);
  tvert runtime = mkvert(V3(x, 0.4072f, 0.f));
  DEBUG_VALUE(a + runtime);
  
 }
}
function Reference_Preset_Data
driver_get_reference_preset_data(Reference_Preset preset)
{// NOTE @driver_api
 // NOTE(kv) Should this be static data?
 // If it was, we'd have to update it every frame to read the sliders.
 // Which is ineffcient but maybe that's just what we... do?
 Reference_Preset_Data result = {};
 result.image;
 switch(preset)
 {
  case Preset_Back:
  {
   result.camera_phi2 = 0.5f;
   {
    Reference_Image &image = result.image;
    image.filename  = image_left_arm_back;
    image.center    = fv(tvert_13);
    image.x_axis    = fv(v3_14);
    image.alpha     = 0.3033f;
   }
   result.pose.tarm_abduct = fv(v1_15);
  }break;
  
  case Preset_Arm_Profile:
  {
   result.camera_phi2 = 0.25f;
   {
    Reference_Image &image = result.image;
    image.filename  = fimage(strlit("G:/My Drive/Art/AM arm profile 2.JPG"));
    image.center    = fv(tvert_16);
    image.x_axis    = fv(v3_17);
    image.alpha     = 0.299f;
   }
  }break;
  
  case Preset_Eco_Skeleton:
  {
   fpreset(Preset_Eco_Skeleton);
   {
    Reference_Image &image = result.image;
    image.filename  = fimage(image_eco_skeleton);
    image.center    = fv(tvert_18);
    image.x_axis    = fv(v3_19);
    image.alpha     = fv(v1_20);
   }
   result.pose.tarm_abduct = fv(v1_21);
  }break;
 }
 return result;
}
function void
compute_bones_from_pose(Pose &pose)
{
 Model *model = the_model;
 
#define MakeBoneBlock(bone, xform) \
push(&model->bone_stack, make_bone(bone, xform)); \
defer(pop(&model->bone_stack);)
 
 v1 torso_scale = head_radius_world*1.2484f;
 for_i32(lr_index,0,2)
 {
  SetInBlock(model->is_right, lr_index);
  {//-Head
   v1 head_phi2_max = 0.15f;   // #Tweak
   v1 head_theta2_max   = 0.125f;  // #Tweak
   v1 head_roll_max  = 0.125f;  // #Tweak
   v1 head_phi2 = pose.thead_phi2 * head_phi2_max;
   v1 head_theta2   = pose.thead_theta2   * head_theta2_max;
   v1 head_roll  = pose.thead_roll  * head_roll_max;
   tvert head_rotation_pivot = fv(tvert_22);  // TODO: This is totally wrong place now!
   mat4i headT = (mat4i_scale(head_radius_world) *
                  mat4i_rotate_tpr(head_phi2, head_theta2, head_roll, head_rotation_pivot));
   if(lr_index){ headT = negateX(headT); }
   MakeBoneBlock(mk_bone_id(Bone_Head), headT);
   
   {//-Eyeball
    tvert eyeO = fv(tvert_23);
    v3 eye_scale = V3(0.8324f, 0.9882f, 0.92f);
    mat4i eyeT = mat4i_translate(eyeO)*mat4i_scales(eye_scale);
    tvert eye_in = eyeT*fv(tvert_24);
    tvert eye_out = eye_in + mkvec(2.f * eye_in.x+(-0.03f), 0, -0.154f);
    eyeball_center = eyeT*fv(tvert_25);
    mat4i to_eyeball = mat4i_translate(eyeball_center);
    eyeball_radius = (eye_out.x - eye_in.x)*0.4526f;
    mat4i eyeball_scale = mat4i_scale(eyeball_radius);
    mat4i rot;
    {// NOTE: We don't have theta yet
     v1 eyeball_phi = 0.13f*(pose.teye_phi2);
     if(lr_index){ eyeball_phi *= -1; };
     rot = mat4i_rotateY(eyeball_phi);
    }
    mat4i eyeballT = to_eyeball*eyeball_scale*rot;
    make_bone(mk_bone_id(Bone_Eyeball), eyeballT);
   }
  }
  {//-Pelvis
   v1 head_topY = head_radius_world;
   v3 translate = V3(0.f,
                     head_topY - 3.2f * head_unit_world, 
                     0.067f);
   mat4i pelvisT = mat4i_translate(translate) * mat4i_scale(head_radius_world);
   if(lr_index){ pelvisT = negateX(pelvisT); }
   make_bone(mk_bone_id(Bone_Pelvis), pelvisT);
  }
  
  mat4i torsoT = mat4i_scale(torso_scale);
  if(lr_index){ torsoT = negateX(torsoT); }
  
  {
   MakeBoneBlock(mk_bone_id(Bone_Torso), torsoT);
   mat4i armT;
   {
    v1 arm_ry = head_unit_world*(0.5302f);
    // ;armT Calculate upper arm transform, so we can draw attachments to it
    v1 scale = arm_ry / torso_scale; // NOTE Because it's multiplied by torsoT
    fpreset(Preset_Arm_Profile);
    fimage(image_scapula_profile, fv(v2_26));
    tvec change = fv(v3_27);
    scap_sock_top = fv(tvert_28) + change;  // ;scap_sock_top
    v3 translate = scap_sock_top + fv(v3_29)-change;
    v1 roll = -pose.tarm_abduct;
    mat4i rotateT = mat4i_rotate_tpr(0, 0, roll);
    arm_rotation_pivot = fv(tvert_30);  // ;arm_rotation_pivot
    armT = trs_pivot_transform(translate, rotateT, scale, arm_rotation_pivot);
   }
   {// IMPORTANT: The ratio forearm/upper_arm=0.8 is measured on the iPad,
    // Loomis female proportions, also gvaat
    // I'm almost certain it's "correct"
    
    MakeBoneBlock(mk_bone_id(Bone_Arm), armT);
    vv0_overlay(arm_rotation_pivot);
    
    // NOTE ;arm_bend_max The number from Manga Materials is 145 degrees,
    // which seems a bit short but idk our elbow might be completely wrong
    v1 arm_bend_max = -0.5f;
    v1 forearm_turn = pose.tarm_bend * arm_bend_max;
    v3 forearm_translate = fv(v3_31);
    mat4i rotate = mat4i_rotateX(forearm_turn);
    forearm_rotation_pivot = fv(tvert_32);
    // ;forearmT
    mat4i forearmT = trs_pivot_transform(forearm_translate, rotate, 1.f,
                                         forearm_rotation_pivot);
    {
     MakeBoneBlock(mk_bone_id(Bone_Forearm), forearmT);
     vv0_overlay(forearm_rotation_pivot);
     palm_in = fv(tvert_33);
     vv0(palm_in);
     mat4i handT = mat4i_translate(palm_in + fv(v3_34));
     {
      MakeBoneBlock(mk_bone_id(Bone_Hand), handT);
      mat4i thumbT;
      {
       // NOTE: addution: "adding" the thumb to your hand,
       // NOTE: (max 0.0331f, but meh our anatomy might be totally wrong)
       v1 tadduct = 0.f;
       //v1 toppose = fv 0.f;      // NOTE: like the meditation hand gesture
       //if (toppose) { thumbT = mat4i_rotateY(-toppose, thumb_kbot); }
       // TODO: Hm, this doesn't line the thumb up all the way, there's some other motion in play
       // TODO: How do we know whether to abduct/adduct or to oppose?
       // Or is this even the right framework?
       thumb_kbot = fv(tvert_35);
       thumbT = mat4i_rotateZ(-tadduct, thumb_kbot);
      }
      make_bone(mk_bone_id(Bone_Thumb), thumbT);
      
      v1 bot_tbend = 0.f;
      i32 finger_count = 4;  // NOTE: Do I gotta tell you?
      knuckle_ts = v4{
       0.1236f,
       0.3668f,
       0.6424f,
       0.8955f,
      };
      kline_in  = fv(tvert_36);
      kline_out = fv(tvert_37);
      knuckle_line = bez_unit(kline_out, V2(-0.0263f, 0.259f),
                              V2(0,0),
                              V3y(-1), kline_in);
      for_i32(index,0,finger_count)
      {
       knuckle_tops[index] = bezier_sample(knuckle_line, knuckle_ts[index]);
      }
      tvec finger_vecs_[4] = {
       -V3y(0.5077f), //index
       -V3y(0.5619f), //middle
       -V3y(0.5247f), //ring
       -V3y(0.4449f), //pinky (NOTE: lines up with the ring's top knuckle)
      };
      copy_array_src(finger_vecs, finger_vecs_);
      
      for_i32(ifinger,0,finger_count)
      {
       tvert k = knuckle_tops[ifinger];
       {
        MakeBoneBlock(mk_bone_id(Bone_Bottom_Phalanx, ifinger),
                      mat4i_rotateX(-bot_tbend, k));
        v1 mid_tbend = 0.f;
        v3 vec = finger_vecs[ifinger];
        tvert kmid = k+0.5f*vec;
        {
         MakeBoneBlock(mk_bone_id(Bone_Mid_Phalanx, ifinger),
                       mat4i_rotateX(-mid_tbend, kmid));
         v1 top_tbend = 0.f;
         tvert ktop = k+0.75f*vec;
         make_bone(mk_bone_id(Bone_Top_Phalanx, ifinger),
                   mat4i_rotateX(-top_tbend, ktop));
        }
       }
      }
     }
    }
   }
  }
 }
 
 {
  b32 lr_index = 0;
  make_bone(mk_bone_id(Bone_References), mat4i_scale(head_radius_world));
 }
#undef MakeBoneBlock
}
//~
#define macro_import_vertex(vertex)  tvert vertex = ot.inv * vertex##_world;
#define macro_export_vertex(vertex)  vertex##_world = ot * vertex;
#define macro_world_declare(vertex)   tvert vertex##_world;
#define level1 (painter->viz_level >= 1)
#define level2 (painter->viz_level >= 2)
#define X_comma_list(NAME)              NAME,
//~
function void
render_hand(Forearm forearm)
{
 vertex_block("hand");
 PaintBlock;
 scale_line_radius(0.5038f);
 painter->params.nslice_per_meter = 5.9797f * 100.f;
 
 mat4i ot = current_world_from_bone();
 import_vertices(forearm, mk_bone_id(Bone_Forearm));
 
 // NOTE: The "palm_base" moves along with the hand
 tvert palm_base_in = fv(tvert_38);
 vv0(thumb_kbot);
 Bez palm_base_line = bez_unit(thumb_kbot, V2(0.f, 0.3416f),
                               V2(0,0),
                               V3y(-1), palm_base_in);
 draw(palm_base_line, lp(I4(2,2,4,8)));
 bezier_sample(palm_base_line, 0.5f);
 
 draw(bez_unit(palm_base_in,
               V2(-0.1358f, 0.5181f),
               V2(0.3399f, 0.2818f), 
               V3(-0.8552f, 0.f, -0.5183f),
               kline_in),
      lp(I4(8,0,3,1)));
 tvert thumb_palm_conn = fv(tvert_39);
 draw(bez_v3v2(thumb_kbot, V3(), V2(), thumb_palm_conn));
 {// NOTE: Thumb
  BoneBlock(mk_bone_id(Bone_Thumb));
  
  //NOTE: "thumb_triangle_tip" is a prominent bump on your palm
  tvert thumb_triangle_tip = fv(tvert_40);
  draw(bez_line(thumb_kbot, thumb_triangle_tip),
       lp(I4(2,4,0,3)));
  
  tvert thumb_kmid_in = fv(tvert_41);
  draw(bez_unit(thumb_kmid_in, V2(0.f, 2.9015f),
                V2(0,0), V3y(1), from_parent()*thumb_palm_conn));
  tvert thumb_ktop_in = fv(tvert_42);
  draw(bez_line(thumb_kmid_in, thumb_ktop_in),
       lp(I4(8,4,3,1)));
  // NOTE: I really don't know where these should be?
  tvert thumb_tip = fv(tvert_43);
  tvert thumb_kmid_out = fv(tvert_44);
  draw(bez_unit(thumb_triangle_tip, V2(-0.2102f, 0.1944f),
                V2(0.4217f, 0.2078f), V3x(-1),
                thumb_kmid_out),
       lp(I4(2,4,4,6)));
  tvert thumb_ktop_out = fv(tvert_45);
  draw(bez_unit(thumb_kmid_out, V2(0, 0.3706f),
                V2(0,0), V3x(-1),
                thumb_ktop_out));
  draw(bez_unit(thumb_ktop_out, V2(0, 0.2369f),
                V2(0.4569f, -1.7741f), V3x(-1), thumb_tip),
       lp(I4(4,1,2,1)));
  draw(bez_unit(thumb_ktop_in, V2(0,0),
                V2(0.2207f, 1.4562f), V3x(-1), thumb_tip),
       lp(I4(1,1,1,2)));
 }
 draw(bez_line(thumb_palm_conn, kline_out), lp(I4(5,3,1,1)));
 if(level1){ draw(knuckle_line); }
 
 draw(bez_v3v2(forearm.radius_bump, V3(0, 0.0101f, 0.0167f),
               V2(0,0), thumb_kbot));
 
 {// NOTE: The knuckles and fingers ;draw_fingers
  vertex_block("knuckles/fingers");
  i32 const FINGER_COUNT = 4;
  tvert knuckle_bots[FINGER_COUNT];
  {
   v3 tb_vec = V3y(0.06f);
   for_i32(index,0,4){
    knuckle_bots[index] = knuckle_tops[index]+tb_vec;
   }
  }
  
  for_i32(index,0,FINGER_COUNT){
   draw_line(knuckle_tops[index], knuckle_bots[index]);
  }
  
  {// NOTE Trying to define the profile view here
   tvert middle_knuckle_bot = knuckle_bots[1];
   tvert middle_palm_bot = knuckle_bots[1] + fv(v3_46);
   draw_line(middle_knuckle_bot, middle_palm_bot, lp(I4((3))));
   draw(bez_unit(forearm.middle_finger_meeter, V2(-0.1285f, 0.1793f),
                 V2(0.f, -0.5674f), V3z(-1), middle_palm_bot));
  }
  
  tvert finger_bases[FINGER_COUNT+1];
  {
   v1 finger_base_ts[FINGER_COUNT+1] = { 0.f, 0.2267f, 0.5f, 0.75f, 1.f, };
   v3 offset = -V3y(0.0818f);
   for_i32(index,0,FINGER_COUNT+1)
   {
    finger_bases[index] = (bezier_sample(knuckle_line, finger_base_ts[index]) +
                           offset);
    vv(finger_bases[index]);
   }
  }
  
  v1 top_tbend = 0.f;
  
  for_i32(ifinger,0,FINGER_COUNT)
  {//-The dreaded fingers
   BoneBlock(mk_bone_id(Bone_Bottom_Phalanx, ifinger));
   
   tvert k = knuckle_tops[ifinger];
   v3 vec = finger_vecs[ifinger];
   v3 xvec = V3x(0.0367f);
   
   tvert kmid = k+0.5f*vec;
   tvert ikmid = kmid-xvec;
   tvert okmid = kmid+xvec;
   
   {// NOTE bottom phalanges
    v2 knuckle_control = V2(0.4816f, 0.329f);
    // NOTE: the webbing doesn't connect together very well
    draw(bez_unit(finger_bases[ifinger], V2(0.f, 0.5811f),
                  knuckle_control, V3x(-1), okmid),
         lp(I4(3,1,1,1)));
    draw(bez_unit(finger_bases[ifinger+1], V2(-0.3782f, 0.3545f),
                  knuckle_control, V3x(1), ikmid),
         lp(I4(3,3,3,1)));
    
    if(ifinger == 0)
    {// NOTE: concerning the index finger
     draw(bez_v3v2(kline_out, V3(0.0001f, 0.f, 0.f),
                   V2(0,0), finger_bases[0]),
          lp(I4(0,1,1,3)));
    }
    if(ifinger == FINGER_COUNT-1)
    {// NOTE: pinky
     draw(bez_v3v2(finger_bases[ifinger+1], V3(-0.0049f, 0.f, 0.f),
                   V2(0,0), kline_in),
          lp(I4(2,3,0,1)));
    }
   }
   
   {// NOTE middle phalanges
    BoneBlock(mk_bone_id(Bone_Mid_Phalanx, ifinger));
    
    tvert ktop = (k+0.75f*vec);
    tvert iktop = ktop-xvec;
    tvert oktop = ktop+xvec;
    {// NOTE: middle phalanges
     v2 control = V2(-0.0473f, 0.7281f);
     draw(bez_unit(ikmid, control, V2(), V3x(1), iktop),
          lp(I4(3,3,3,1)));
     draw(bez_unit(okmid, control, V2(), V3x(-1), oktop),
          lp(I4(3,0,2,3)));
    }
    
    tvert tip = k+vec;
    {// NOTE top phalanges
     BoneBlock(mk_bone_id(Bone_Top_Phalanx, ifinger));
     
     v2 tip_control = V2(-0.3298f, 1.1379f);
     v2 knuckle_control = V2(0.2954f, -0.1896f);
     draw(bez_unit(tip, tip_control, knuckle_control, V3x(-1), iktop),
          lp(I4(3,0,0,2)));
     draw(bez_unit(tip, tip_control, knuckle_control, V3x(1), oktop),
          lp(I4(4,0,2,3)));
    }
   }
  }
 }
}
myinline b32
showing_skeleton()
{
 return show_skeleton and is_left();
}
function void
set_skeleton_params()
{
 auto &params = painter->params;
 params.line_color = linear_argb_yellow;
 // NOTE(kv) Offseting skeleton to overlay it on top of body is complete jank,
 // because it can be near clipped. What we *really* want is layers.
 // NOTE(kv) But funnily, our fov is very short,
 // which makes the near clip not activate, almost ever.
 v1 offset = fv(v1_47) * centimeter;
 params.line_depth_offset -= offset;
 params.fill_depth_offset -= offset;
}
function Arm
render_arm(Pose &pose, Torso torso, tvert elbow_up_out)
{
 ViewCenterBlock(fv(tvert_48));
 mat4i &ot = current_world_from_bone();
 import_vertices(torso, mk_bone_id(Bone_Torso));
 
 v1 tarm_bend = (pose.tarm_bend);
 vv0_overlay(arm_rotation_pivot);
 
 if(painter->show_grid or get_reference_preset() == Preset_Eco_Skeleton)
 {//-Diagramming
  hl_block_color(linear_argb_dark_blue);
  draw(bez_line(arm_rotation_pivot, arm_rotation_pivot + fv(v3_49)));
 }
 
 tvert internal_condyle = fv(tvert_50);  // ;internal_condyle
 tvert external_condyle = internal_condyle+V3(0.4031f, 0.1064f, 0.0402f);
 {//NOTE: The skeleton (humerus and ulna)
  PaintBlock;
  ShowGroup(Vis_Skeleton);
  fimage(image_skeletal_meat_outline);
  set_skeleton_params();
  
  tvert sock = fv(tvert_51);
  {//NOTE: Internal condyle
   tvert v89 = internal_condyle+fv(v3_52);
   draw(bez_parabola(sock, fv(v3_53), v89),
        lp(V4(0.5f)));
   draw(bez_unit2(v89, V4(0.f, 0.4207f, 0.f, 0.f),
                  V3(0.5647f, -0.8253f, 0.f), internal_condyle),
        lp(0.5f*big_to_small()));
  }
  {//NOTE: External condyle
   ShowAlignedSymIf(V3z(1.f), fv(v1_54));
   tvert a = external_condyle+fv(v3_55);
   tvert b = fv(tvert_56);
   draw(bez_unit2(a, V4(0.f, 1.0357f, 0.f, 0.f),
                  V3(-0.1623f, -0.9867f, 0.f), external_condyle));
   fcurve(Curve_0, b, a);
  }
  tvert v98 = sock+V3(0.0947f, 0.1683f, 0.2105f);
  tvert v99 = v98+V3(-0.f, -0.6114f, -0.0063f);
  {
   fpreset(Preset_Arm_Profile);
   ShowAlignedSymIf(V3x(1.f), fv(v1_60));
   draw(bez_parabola(v98, fv(v3_61), v99));
   tvert v01 = v99 + fv(v3_62);
   draw(bez_v3v2(v99, V3(-0.f, 0.f, -0.0834f),
                 V2(0.2691f, 0.0874f), v01));
   tvert v20 = v01+V3(-0.0184f, -0.1643f, -0.0453f);
   draw(bez_parabola(v01, V3(0.f, 0.0368f, 0.1927f), v20));
  }
  
  {// ;test_BoneBlockApplied
   fimage(image_socket_and_ball);
   mat4 TMP_XFORM = current_world_from_bone().inv*get_world_from_bone(Bone_Torso);
   tvert center = fv(tvert_63);
   tdim radius = fv(tdim_64);
   draw_circle(center, fv(tnormal_65), radius);
   draw_circle(center, normal_z, radius);
   fill_sphere(center, radius);
  }
 }
 
 tvert delt_bot  = fv(tvert_66);
 tvert delt_back = fv(tvert_67);
 Bez delt_cross;
 Bez delt_back_line;
 Bez delt_bot_line;
 Bez delt_vfront;
 tvert delt_back_point = torso.scap_delt;
 {//-Deltoid
  tvert delt_top      = torso.shoulder + fv(v3_68);
  tvert delt_top_back = delt_top + fv(v3_69);
  Bez delt_hline = bez_unit2(delt_top,
                             V4(-0.059f, 0.584f, 0.f, 0.f),
                             V3(0.f, 1.f, 0.f),
                             delt_top_back);
  draw(delt_hline, i2f6(I4(0,3,2,0)));
  fill_bez(delt_hline);
  
  delt_vfront = bez_unit2(delt_top, 
                          V4(-0.3452f, 0.3717f, 0.0022f, 0.1226f),
                          V3(0.0087f, 0.f, 1.f),
                          delt_bot);
  draw(delt_vfront);
  Bez delt_vmid = bez_unit2(delt_top,
                            V4(-0.2234f, 0.2079f, 0.015f, 0.1626f),
                            V3(0.9999f, 0.f, 0.0112f),
                            delt_bot);
  Bez delt_vback = bez_unit2(delt_top_back,
                             V4(-0.13f, 0.1784f, -0.1368f, 0.2863f),
                             V3(0.6431f, 0.f, -0.7657f),
                             delt_bot);
  fill3(delt_back, delt_bot, delt_top_back);
  
  {
   PaintBlock;
   painter->params.line.alignment_min = (0.8202f);
   draw(delt_vmid);
  }
  //if (level1)
  {
   PaintBlock;
   painter->params.line.alignment_min = (0.6061f);
   draw(delt_vback, lp(V4(0.712f, 0.f, 0.f, 0.5464f)));
   fill_bez(delt_vback);
  }
  delt_bot_line = bez_bezd_old(delt_bot, (V3()),
                               V2(0,0), delt_back);
  draw(delt_bot_line, i2f6(I4(4,0,0,4)));
  //NOTE: fill the side
  fill_dual_bez(delt_vfront, delt_vmid);
  fill_dual_bez(delt_vmid, delt_vback);
  draw(bez_unit2(delt_top_back, V4(), V3(), torso.scap_delt));
  
  delt_back_line = bez_unit2(delt_back,
                             V4(-0.1729f, -0.1804f, 0.1064f, 0.2869f), 
                             V3(0.f, -1.f, 0.004f),
                             delt_back_point);
  draw( delt_back_line, I4(1,4,4,1));//TODO: Wow this line is terrible
  //note: fill the back side of the deltoid
  fill4( delt_top_back, delt_back, delt_back_point, torso.scap_delt);
  
  delt_cross = bezd_len(torso.delt_collar, 
                        V3(0.0677f, 0.1554f, 0.2652f),
                        V2(0.f, 0.2143f),
                        delt_bot);
  draw(delt_cross, I4(1,2,5,4));
  
  // NOTE: Fill in the effing arm-torso connections!!!
  fill_point_bez(delt_top,delt_cross);
  fill_bez( delt_cross);
  
  {
   // Fill in the front
   fill_point_bez( bezier_sample(delt_cross, (0.5f)), delt_vfront);
  }
 }
 tvert pectoral_arm = fv(tvert_70);
 {
  Bez line = bez_unit2(pectoral_arm,
                       V4(0.f, 0.3866f, 0.f, 0.f),
                       V3(-0.997f, 0.0775f, 0.f),
                       torso.pectoral_torso);
  draw(line);
  fill_point_bez(torso.delt_collar, line);
 }
 
 tvert bicep_out_top = bezier_sample(delt_cross, 0.8389f);
 tvert bicep_out_bot = (fv(tvert_71) +
                        lerp(V3(), tarm_bend, V3()));
 tvert bicep_in_top = bicep_out_top+fv(v3_72);
 fimage(image_mm_full_body_muslce_front, fv(v2_73));
 tvert bicep_in_bot = bicep_out_bot+fv(v3_74);
 
 fimage(image_tricep_brachii_tendon);
 fimage(image_left_arm_back, fv(v2_75));
 tvert tricep_mid = fv(tvert_76);
 
 fimage(image_left_arm_back, fv(v2_77));
 tvert white_in  = tricep_mid+fv(v3_78);
 
 tvert white_out = tricep_mid+fv(v3_79);
 tvert tricep_wedge = delt_bot+fv(v3_80);
 
 // todo(kv) @brachio_a might just be misplaced, it should be in the forearm
 fimage(image_brachio_front, fv(v2_81));
 tvert brachio_a = fv(tvert_82);  // ;brachio_a
 
 {//NOTE: The 'ceps
  {//NOTE: tricep
   tvert tricep_up = (bezier_sample(delt_back_line, 0.2993f));
   //NOTE: The white part
   {
    fimage(image_left_arm_back);
    draw(bezd_len(delt_back, V3(-0.f, 0.f, -0.0662f),
                  V2(0,0), tricep_mid),
         I4(5,0,0,0));
    draw(bez_line(tricep_mid, white_in), i2f6(I4(3,0,0,0)));
    draw(bez_line(tricep_mid, white_out), i2f6(I4(1,1,1,1)));
   }
   tvert tricep_out_top = (bezier_sample(delt_bot_line, (.3f)));
   if (level1) { draw(bez_line(tricep_out_top, tricep_wedge)); }
   fill4(tricep_wedge, tricep_mid, delt_back, delt_bot);
   fill3(white_out, tricep_mid, tricep_wedge);
   
   {// todo Adjusting this line
    fimage(image_left_arm_back, bez_v2_offset(fv(v2_83), fv(v2_84), fv(v2_85)));
    fimage(image_triceps_long_head);
    fimage(image_arm_muscle_connection);
    ShowAlignedIf(V3z(-1), fv(v1_86));
    fpreset(Preset_Back);
    draw(bez_v3v2(torso.scap_sock_bot, fv(v3_87),
                  fv(v2_88), white_in),
         lp(I4(0,0,8,0)));
   }
  }
  
  {//NOTE: bicep
   //NOTE: Outer line
   Bez front_out = bez_unit2(bicep_out_top,
                             (V4(-0.0571f, 0.0667f, 0.f, 0.f)),
                             (V3(0.7886f, 0.f, 0.6149f)),
                             bicep_out_bot);
   tvert hinge_out = (bezier_sample(front_out, 0.6758f));
   
   fill3(brachio_a, hinge_out, bicep_out_bot);
   Bez front_in = bez_unit2(bicep_in_top,
                            (V4(0.f, 0.0397f, 0.0201f, 0.1254f)),
                            (V3(-0.8434f, 0.f, 0.5373f)),
                            bicep_in_bot);
   
   fimage(image_upper_body_front_muscle,
          bez_v2_offset(fv(v2_89), fv(v2_90), fv(v2_91)));
   {// todo Let's make alignment adjustment better, with this as example
    ShowAlignedIf(V3z(1), fv(v1_92));
    draw(front_in, lp(I4(0,0,0,4)));
   }
   
   fill_dual_bez(front_in, front_out);
   tvert bicep_side_top = bezier_sample(delt_vfront, 0.9539f);
   tvert bicep_side_bot = bicep_out_bot + (V3(0.1103f, 0.1089f, -0.084f));
   Bez side_out = bezd_len(bicep_side_top, (V3(-0.f, 0.f, -0.0502f)),
                           V2(0,0), bicep_side_bot);
   draw(side_out, i2f6(I4(4,0,0,0)));
   fill3(pectoral_arm, bicep_in_top, bicep_out_top);
   fill3(pectoral_arm, torso.delt_collar, bicep_out_top);
   
   tvert bicep_side_top2 = bezier_sample(delt_cross, 0.7406f);
   tvert bicep_side_bot2 = bicep_out_bot+(V3(-0.0601f, 0.f, 0.f));
   {
    v1 alignment = 0.9169f;
    Bez bicep_side_line2 = bez_unit(bicep_side_top2,
                                    V2(0.f, 0.0537f),
                                    V2(0,0),
                                    V3z(1.f),
                                    bicep_side_bot2);
    
    {
     PaintBlock;
     painter->params.line.alignment_min = alignment;
     draw(bicep_side_line2, lp(I4(4,3,1,0)));
    }
    b32 drawn = painter->previous_draw_result;
    
    if(drawn){
     draw(front_out, lp(I4(5,0,0,0))); 
    }
    fill_bez(bicep_side_line2);
   }
   
   fill4(bicep_side_top, bicep_side_top2, bicep_side_bot2, bicep_out_bot);
   
   {
    b32 ok = get_view_vector().x < 0.07f;
    i4 radii = I4(6,6,0,0);
    if (get_view_vector().x > -0.20f ) {
     radii.y = 0;
    }
    if (ok)
    {
     draw(bez_v3v2(bicep_side_top2,
                   (V3(0.0184f, 0.f, 0.0925f)),
                   V2(0,0),
                   brachio_a),
          lp(radii));
    }
   }
  }
 }
 
 draw(bez_line(brachio_a, bicep_out_bot), i2f6(I4(3,3,3,1)));
 
 fimage(image_arm_profile_full, brachio_humerus_profile_uv);
 fimage(image_brachio_profile_bone, fv(v2_93));
 tvert brachio_humerus = fv(tvert_94);  //;brachio_humerus
 
 if(0)
 {// NOTE: Patching
  // TODO: wow this patch sucks, big time
  fill4(brachio_humerus, delt_bot, bicep_out_top, bicep_out_bot);
 }
 
 {// NOTE Hiding planes
  //SetInBlock(painter->painting_disabled, 0);
  tvert a = fv(tvert_95);
  tvert b = internal_condyle+fv(v3_96);
  
  Bezier la = bez_v3v2(a, fv(v3_97), fv(v2_98), b);
  Bezier lb = bez_v3v2(a+fv(v3_99),
                       fv(v3_100), fv(v2_101),
                       b+fv(v3_102));
  PaintBlock;
  painter->params.fill.flags.v |= Fill_Culled;
  fill_dual_bez(la, lb);
 }
 
 fimage(image_brachialis_vs_skeleton, fv(v2_103));
 tvert brachialis_begin = fv(tvert_104);
 
 Arm arm_obj;
 {//~NOTE: Exports
#define export_(vertex)  arm_obj.vertex = vertex;
  macro_arm(export_);
#undef export_
 }
 return arm_obj;
}
function Forearm
render_forearm(Arm arm, tvert elbow_up_out)
{// @forearmT
 mat4i ot = current_world_from_bone();
 import_vertices(arm, mk_bone_id(Bone_Arm));
 tvert forearm_view_center = fv(tvert_105);
 ViewCenterBlock(forearm_view_center);
 
 {// NOTE The forearm bones from the front view (as rough guide)
  PaintBlock;
  ShowGroup(Vis_Skeleton);
  set_skeleton_params();
  fimage(image_skeletal_meat_outline);
  tvert down_common;
  tvert up = fv(tvert_106);
  //NOTE: ulna (inner, main bone)
  tvert up1 = up+fv(v3_107);
  down_common  = palm_in+fv(v3_108);
  Bez l492 = bez_parabola(down_common, fv(v3_109), up1);
  {
   ShowAlignedSymIf(V3z(1.f), cos_45_degree);
   draw(l492);
   {
    PaintBlock;
    painter->params.line.alignment_min = 0.5f;
    draw(bez_parabola(up, fv(v3_110), palm_in));
   }
  }
  tvert v676 = fv(tvert_111);
  tvert v677 = v676+fv(v3_112);
  {
   PaintBlock;
   painter->params.line.alignment_min = fv(v1_113);
   draw(bez_v3v2(v676, fv(v3_114),
                 V2(0.f, 0.0936f), v677));
  }
  
  {//NOTE: Radius (outer)
   ShowAlignedSymIf(V3z(1.f), cos_45_degree);
   PaintBlock;
   painter->params.line.alignment_min = 0.5f;
   tvert up596 = bezier_sample(l492, 0.9006f);
   draw(bez_parabola(down_common, fv(v3_115), up596));
   tvert down2 = down_common + fv(v3_116);
   tvert up2 = up + fv(v3_117);
   draw(bez_parabola(down2, fv(v3_118), up2));
  }
 }
 
 {// todo This line shows the bicep at the front, but it should only show at the front
  ShowAlignedSymIf(V3z(1.f), cos_45_degree);
  fimage(image_brachialis_vs_skeleton,
         bez_v2_offset(fv(v2_119), fv(v2_120), fv(v2_121)));
  Bez line = bez_v3v2(arm.brachialis_begin, fv(v3_122),
                      fv(v2_123), arm.brachio_a);
  draw(line, flp(FUI_Line_Params_124));
  fill_bez(line);
 }
 
 tvert near_palm_in = palm_in+V3(-0.0491f, 0.0154f, 0.04f);
 Bez l500;
 tvert in_c;
 {// NOTE: Inner side
  tvert in_a = fv(tvert_125);
  tvert in_b = fv(tvert_126);
  in_c = fv(tvert_127);
  Bez l493 = bez_v3v2(in_a, V3(-0.0385f, 0.f, 0.f),
                      V2(0,0), in_b);
  draw(l493, lp(I4(0,2,2,5)));
  fill3(in_b+V3(0.0076f, 0.f, -0.0131f), arm.bicep_in_bot, in_c);
  {
   Bez l499 = bez_c2(l493, V3(), in_c);
   draw(l499, lp(I4(5,3,3,0)));
   fill_bez(l499);
   l500 = bez_c2(l499, V3(0.0348f, 0.0219f, -0.0201f), near_palm_in);
   draw(l500, lp(I4(0,1,5,1)));
  }
 }
 
 tvert brachio_b;
 tvert brachio_c;
 {//NOTE: Outer side (the thumb side): Brachio-radialis
  vertex_block("brachio");
  tvert a = arm.brachio_a;
  brachio_b = a + fv(v3_128);
  brachio_c = fv(tvert_129);
  tvert b = brachio_b;
  tvert c = brachio_c;
  draw(bez_v3v2(b, V3(0.0352f, 0.f, -0.f),
                V2(0,0), c),
       lp(I4(6,5,3,1)));
  fill4(a,b,c, arm.bicep_out_bot);
  fill_point_bez(c, l500);
  fill4(in_c, brachio_c, arm.bicep_out_bot, arm.bicep_in_bot);
  fill3(arm.external_condyle,b,c);
 }
 
 {//NOTE: The elbow (It moves when you bend your arm, so it has to be in the forearm)
  vertex_block("elbow");
  
  tvert o = forearm_rotation_pivot;
  tvert up_in  = o + fv(v3_130);
  tvert low_in = o + fv(v3_131);
  i4 elbow_radii = I4(4,3,3,2);
  draw(bez_line(up_in,low_in), elbow_radii);
  tvert up_out = elbow_up_out;
  fimage(file_arm_back_bone, fv(v2_132));
  tvert low_out = o + fv(v3_133);
  draw(bez_line(up_out,low_out), elbow_radii);
  
  {// NOTE ;tricep_connections
   draw(bez_line(arm.white_in, up_in), I4(0,3,3,6));
   draw(bez_line(arm.white_out, up_out), I4(0,0,0,6));
  }
 }
 
 // brachio_top
 {
  ShowAlignedSymIf(V3z(1.f), cos_45_degree);
  fimage(image_brachio_front,
         bez_v2_offset(fv(v2_134), fv(v2_135), fv(v2_136)));
  draw(bez_v3v2(arm.brachio_humerus,
                fv(v3_137), fv(v2_138),
                arm.brachio_a));
  fimage(image_brachio_front,
         bez_v2_offset(fv(v2_139), fv(v2_140), fv(v2_141)));
  // NOTE(kv) Turn on the MM overlay here.
  // It looks weird but still matches reference so...
  draw(bez_v3v2(arm.brachio_humerus,
                fv(v3_142), fv(v2_143),
                fv(tvert_144)));
 }
 // todo Draw this line, and fill it!
 fimage(image_arm_profile_full,
        bez_v2_offset(brachio_humerus_profile_uv, fv(v2_145), fv(v2_146)));
 fill3(arm.brachio_humerus, arm.brachio_a, elbow_up_out);
 
 tvert radius_bump = (palm_in+V3(0.2725f, 0.1637f, -0.0384f));
 {
  Bez l576 = bez_v3v2(brachio_c, V3(-0.0479f, 0.0162f, 0.0042f),
                      V2(0,0), radius_bump);
  draw(l576, lp(I4(1,3,3,0)));
  fill_point_bez(near_palm_in, l576);
 }
 tvert v593 = mkvert(lerp(brachio_c, 0.1619f, in_c));
 tvert radius_back = (palm_in+(V3(0.2716f, 0.1061f, -0.1844f)));
 {// NOTE: wrist
  tvert ulnar_ball = (palm_in+V3(-0.0308f, 0.2166f, -0.0893f));
  tvert v566 = fv(tvert_147);
  draw(bez_v3v2(ulnar_ball, (V3(0.0482f, 0.f, -0.f)),
                V2(0,0), v566),
       lp(I4(0,5,2,0)));
  draw(bez_v3v2(arm.internal_condyle, (V3(-0.0671f, 0.f, 0.f)),
                V2(0,0), v566),
       lp(I4(1,5,5,0)));
  // NOTE: This part of the wrist is receded from the palm
  // NOTE: You can feel the radius bump on your wrist
  draw_line(radius_back, radius_bump);
  fill3(radius_back, v593,
        lerp(radius_bump, 0.1308f, near_palm_in));
 }
 tvert middle_finger_meeter = fv(tvert_148);
 
 tvert v2189 = fv(tvert_149);
 draw(bez_v3v2(v2189,
               V3(0.f, 0.1288f, 0.1481f),
               V2(0,0),
               V3(0.1923f, -1.8531f, -0.198f)));
 
 Bez l618 = bez_v3v2(arm.external_condyle, V3(0.0833f, 0.3209f, -0.0449f),
                     V2(0,0), middle_finger_meeter);
 draw(l618);
 tvert v612 = (bezier_sample(l618, 0.7612f));
 fill3(v612, arm.external_condyle, brachio_c);
 fill3(v612, v593, radius_back);
 fill3(v612, brachio_c, v593);
 
 //-Exports
 Forearm forearm_obj;
#define export_(vertex)  forearm_obj.vertex = vertex;
 macro_forearm(export_);
#undef export_
 return forearm_obj;
}
function Torso
render_torso(Pose &pose, Pelvis pelvis, Head head)
{
 // NOTE: Her face somehow looks a lot worse when the body is on?

 ViewCenterBlock(V3(0.f, -2.3176f, 0.3862f));
 mat4i ot = current_world_from_bone();
 v1 head_unit = get_column(ot.inv,1).y * head_unit_world;

 //~ NOTE: Imports
 import_vertices(head, mk_bone_id(Bone_Head));
 import_vertices(pelvis, mk_bone_id(Bone_Pelvis));
 
 fimage(image_clavicle_vs_arm, fv(v2_150));
 fimage(image_clavicle, fv(v2_151));
 // NOTE: Let's decide that shoulder is part of the CLAVICLE
 tvert shoulder = fv(tvert_152);
 vv0(scap_sock_top);
 
 mat4i armT = get_world_from_bone(mk_bone_id(Bone_Arm));
 
 // NOTE: "arm_local" is the arm on the side of the torso being drawn (left/right)
 // because: you wouldn't ever wanna connect the torso to the arm on a different side.
 mat4 arm_local = ot.inv * armT;
 
 // NOTE Fictitious point, that lines up in x with @scap_delt
 tvert shoulder_in = fv(tvert_153);
 
 tvert sternum = fv(tvert_154);
 tvert delt_collar = (shoulder + V3(-0.3387f, -0.02f, 0.1371f));
 tvert sternumL = (sternum + V3x(0.0919f));
 {// NOTE: Neck
  Bezier neck_front_vline = bez_bezd_old(head.head_neck_junction,
                                         V3(-0.f, 0.f, -0.0968f), 
                                         V2(0.f, 0.2897f), sternum);
  {
   PaintBlock;
   painter->params.line.alignment_min = cosine(0.25f*0.5f);
   draw(neck_front_vline);
  }
  
  Bezier neck_back_line = bez_offset(head.trapezius_head,
                                     V3(-0.1529f, -0.1932f, 0.2857f),
                                     V3(-0.1937f, 0.0701f, 0.0969f),
                                     shoulder_in);
  draw(neck_back_line, I4(0,1,3,0));
  
  if(is_left())
  {
   fill_dual_bez(neck_back_line, negateX(neck_back_line));
  }
  
  Bezier collar_in = bez_offset(sternumL,
                                V3(0.2915f, -0.0448f, -0.0087f),
                                V3(-0.1047f, -0.0248f, 0.1171f),
                                delt_collar);
  Bezier collar_out = bez_offset(delt_collar+V3(-0.0957f, 0.0021f, 0.016f),
                                 V3(0.f, 0.f, 0.f),
                                 V3(-0.0607f, 0.0941f, 0.0168f),
                                 shoulder);
  draw(bez_offset(shoulder_in,
                  V3(0.0993f, -0.0342f, -0.f),
                  V3(-0.0356f, 0.0675f, -0.0634f),
                  shoulder),
       I4(5,3,3,1));
  {
   PaintBlock;
   ShowGroup(Vis_Skeleton);
   if(showing_skeleton()){ set_skeleton_params(); }
   draw(collar_out);
   draw(collar_in);
  }
  {//~TODO: Weird code alert!!!
   Bezier sterno;
   {
    sterno = bez_offset(head.behind_ear,
                        V3(-0.107f, -0.2444f, 0.2159f),
                        V3(0.0786f, 0.1842f, -0.1674f),
                        sternumL);
    {// NOTE: sterno contracting animation
     // It's just a lerp between rest pose and turned pose, that's all folks
     v3 patch = V3(-0.1658f, 0.f, -0.0888f);
     v1 thead_phi2 = pose.thead_phi2;
     v1 tcontract = clamp01(+thead_phi2);
     if(is_left())
     {
      tcontract = clamp01(-thead_phi2);
     };
     sterno[1] += tcontract * patch;
    }
   }
   
   //TODO: the sterno is bugged when looked from behind ;sterno_drawing
   draw(sterno, I4(2,0,0,3));
   
   fill_dual_bez(neck_back_line, sterno);
   fill_dual_bez(neck_front_vline, sterno);
  }
 }
 
 fimage(image_deltoid_insertions, fv(v2_155));
 fimage(image_skeletal_meat_outline, fv(v2_156));
 tvert scap_delt = fv(tvert_157);  // ;scap_delt
 
 tvert rib_mid;
 tvert rib_back;
 {//-Rib cage
  // NOTE rib_midY is lower than half shoulder to navel
  v1 rib_midY = shoulder.y - 0.65f*head_unit + -0.0775f;
  rib_mid = mkvert(0.f, rib_midY, 0.8061f);
  {
   ShowIf(is_left());
   ShowAlignedSymIf(V3x(1.f), fv(v1_158));
   draw(bez_bezd_old(sternum,
                     V3(0.f, 0.0027f, 0.2265f),
                     V2(0.f, 0.0935f),
                     rib_mid));
  }
  tvert ribL = (rib_mid+(V3(0.559f, -0.7158f, -0.2772f)));
  // NOTE: I guess the rib cage ends where the elbow is
  tvert rib_in = rib_mid+V3x((0.0905f));
  draw(bez_unit2(rib_in,
                 V4(0.f, 0.0689f, 0.0558f, 0.2431f),
                 V3(0.629f, -0.2482f, 0.7367f),
                 ribL),
       I4(2,6,3,1));
  
  fill4(rib_mid, ribL, delt_collar, sternum);
  rib_back = (ribL+(V3(0.0855f, 0.171f, -0.5742f)));
  draw(bez_unit(ribL, V2(-0.0705f, 0.2667f),
                V2(0.f, 0.384f), 
                V3(0.5421f, -0.8353f, 0.0916f),
                rib_back));
  {//-NOTE: David Finch's vest shape
   tvert vestL = (ribL+(V3(0.0371f, 0.3022f, 0.0011f)));
   draw(bez_unit2(rib_in,
                  V4(0.f, 0.4043f, 0.f, 0.2469f),
                  (V3(0.f, 0.852f, 0.5235f)),
                  vestL));
   tvert vest_back = rib_back+V3(-0.f, 0.5114f, -0.0067f);//todo: where?
   draw(bez_unit2(vestL,
                  V4(-0.0067f, 0.1427f, 0.f, 0.3102f),
                  V3(0.9212f, -0.3891f, -0.f),
                  vest_back));
  }
 }
 
 //NOTE(kv) "latis_arm" actually attaches to the arm
 tvert latis_arm = tag_bone(mk_bone_id(Bone_Arm), arm_local*fv(tvert_159));
 {// NOTE: connection to the arm
  Bez latis_arm_line = bez_unit(rib_back, V2(0.1935f, 0.0429f), 
                                V2(0.151f, 0.0235f),
                                V3(1.f, 0.f, -0.f),
                                latis_arm);
  {
   PaintBlock;
   painter->params.line.alignment_min = 0.7f;
   draw(latis_arm_line);
  }
 }
 
 fpreset(Preset_Arm_Profile);
 fimage(image_scapula_profile, fv(v2_160));
 tvert scap_sock_bot = scap_sock_top + fv(v3_161);
 {// NOTE The back
  tvert trap_bot = fv(tvert_162);
  if(level2)
  {
   hl_block;
   draw(bez_unit2(scap_delt,
                  V4(0.f, 0.1307f, 0.f, 0.0566f),
                  V3(0.5328f, 0.0057f, -0.8462f),
                  shoulder));
  }
  if(is_left())
  {
   fill4_symx(scap_delt, shoulder_in);
  }
  fill3(shoulder_in, shoulder, scap_delt);
  
  fill3_symx(trap_bot,scap_delt);
  Bez hip_back_line = bez_unit(rib_back,
                               V2(0.f, 0.1135f),
                               V2(0.01f, 0.1345f),
                               V3(-0.5382f, 0.f, 0.8428f),
                               pelvis.bikini_up_back);
  draw(hip_back_line);
  // NOTE: Back arch
  tvert back_archL = (bezier_sample(hip_back_line, (0.5606f)));
  draw(bez_v3v3(trap_bot, V3(0.235f, 0.3261f, -0.0079f),
                V3(0.0805f, 0.f, 0.0552f), back_archL));
  
  //if (level2 || preset == 3 || preset == 4)
  {
   PaintBlock;
   ShowGroup(Vis_Skeleton);
   fimage(image_scapula_profile);
   fimage(image_socket_and_ball);
   fimage(image_skeletal_meat_outline);
   fpreset(Preset_Arm_Profile);
   set_skeleton_params();
   tvert scap_bot = scap_delt+V3(0.1134f, -0.7434f, 0.1812f);
   draw(bez_unit2(scap_delt,
                  V4(-0.14f, 0.1607f, 0.4409f, 0.224f),
                  V3(-0.6328f, 0.f, -0.7743f),
                  scap_bot));
   draw(bez_unit2(scap_delt,
                  V4(0,0,0,0),
                  V3(),
                  scap_sock_top));
   draw(bez_unit2(scap_bot,
                  V4(0.f, 0.118f, 0.f, 0.f),
                  V3(-0.f, 0.f, -1.f),
                  scap_sock_bot));
   fcurve(Curve_1, scap_sock_top, scap_sock_bot);
   fcurve(Curve_2, scap_sock_top, scap_sock_bot);
  }
  
  tvert lower_back = fv(tvert_168);
  fill3(lower_back, trap_bot, back_archL);
  
  tvert diamond_up = mkvert(V3z(shoulder_in.z) + V3(0.f, -1.2636f, 0.0193f));
  Bez back_midline = bez_unit2(diamond_up,
                               V4(-0.0605f, 0.1215f, 0.f, 0.f),
                               V3z(-1),
                               trap_bot);
  if(is_left()) 
  {
   draw(back_midline, V4(0.3513f, 0.9763f, 0.6129f, 1.1402f));
  }
  
  tvert diamond_low = (bezier_sample(back_midline, (0.2302f)));
  tvert diamondL = (diamond_up+(V3(0.0856f, -0.2026f, -0.0719f)));
  draw(bez_line(diamond_up, diamondL));
  draw(bez_line(diamond_low, diamondL));
  
  
  Bez trap_vline = bez_unit2(scap_delt, 
                             V4(0.f, 0.0667f, 0.f, 0.f), 
                             V3(-0.379f, 0.f, -0.9254f),
                             bezier_sample(back_midline, 0.9154f));
  draw(trap_vline, V4(0.7542f, 1.f, 1.f, 0.2694f));
  
  tvert trap_weird_point = (bezier_sample(trap_vline, (0.5728f)));
  Bez trap_weird_line = bez_unit2(trap_weird_point,
                                  V4(0.0369f, 0.1268f, 0.f, 0.f),
                                  V3(-0.8654f, 0.f, -0.5011f),
                                  rib_back);
  draw(trap_weird_line, V4(0.75f, 1.f, 1.0735f, 0.5f));
 }
 
 tvert chest_back;
 tvert pectoral_torso;
 {//NOTE: Nipple and chest!
  v1 nippleY = shoulder.y-0.4f*head_unit;  //NOTE: from hpc
  tvert nipple = mkvert(V3y(nippleY) + V3(0.5799f, 0.f, 0.6752f));
  
  tvert chest_in = fv(tvert_169);
  tvert chest_out = fv(tvert_170);
  pectoral_torso = chest_out+V3(0.1171f, 0.1455f, -0.1676f);
  fill3(delt_collar,pectoral_torso,chest_out);
  draw(bez_unit2(chest_in,
                 V4(-0.0299f, 0.2108f, 0.1371f, 0.253f),
                 V3(0.0915f, -0.523f, 0.8474f),
                 chest_out),
       I4(6,4,3,1));
  chest_back = fv(tvert_171);
 }
 
 {//NOTE: Some latissimus lines that are made-up and probably will have to be redone
  Bez latis_side = bez_unit(chest_back, V2(-0.1341f, 0.0768f),
                            V2(0,0), 
                            (V3(0,0,-1)),
                            rib_back);
  {
   PaintBlock;
   painter->params.line.alignment_min = 0.7f;
   draw(latis_side);
  }
 }
 
 if(is_left())
 {//NOTE: Abdoment
  draw(bez_parabola(rib_mid, V3z(-0.0952f), pelvis.navel));
 }
 
 Torso torso_obj = {macro_torso(X_comma_list)};
 return torso_obj;
}
function Pelvis
render_pelvis()
{
 v1 head_topY = head_radius_world;
 mat4i ot = current_world_from_bone();
 
 v1 navelY = (ot.inv * mkverty(head_topY - 2.5f * head_unit_world)).y;
 tvert navel = mkvert(V3y(navelY) + V3z(0.271f));
 
 tvert crotch = mkvert();  // NOTE(kv) Yes, the crotch is the origin, what about it?
 tvert crotchL = fv(tvert_172);
 draw(bez_line(crotch,crotchL));
 {//-Lower
  tvert bikiniL = fv(tvert_173);
  tvec bikini_dir = fv(v3_174);
  draw(bez_unit(crotchL, V2(-0.2081f, 0.2062f), V2(0.316f, 0.3309f),
                bikini_dir, bikiniL));
  draw(bez_unit(crotchL, V2(-0.2767f, 0.2024f), V2(0.213f, 0.2503f),
                -bikini_dir, bikiniL));
 }
 tvert bikini_up_back;
 {//-Upper
  //NOTE: This is from David Finch's "how to draw female torso", which he took from Loomis
  tvert bikini_front_mid = fv(tvert_175);
  tvert girdle_front = (bikini_front_mid + V3(0.8075f, 0.2603f, -0.0717f));
  bikini_up_back = fv(tvert_176);
  Bez girdle_side_line = bez_unit2(girdle_front,
                                   V4(-0.3554f, 0.3781f, 0.2608f, 0.2404f),
                                   V3(0.7543f, 0.6022f, 0.2614f),
                                   bikini_up_back);
  draw(girdle_side_line, I4(0,6,6,1));
  draw(bez_bezd_old(bikini_front_mid, V3(-0.0581f, -0.1036f, 0.f),
                    V2(-0.0136f, 0.1226f), girdle_front));
  {
   fill3(bikini_front_mid, crotch, girdle_front);
   fill3(girdle_front, crotch, bikini_up_back);
   fill_bez(girdle_side_line);
  }
 }
 
 Pelvis pelvis_obj;
#define export_(vertex)  pelvis_obj.vertex = vertex;
 macro_pelvis(export_);
#undef export_
 return pelvis_obj;
}
function void
render_eyes(Pose &pose)
{
 // NOTE: We use this "eyeT" as a compromise: as a small eye sub-system is small.
 // TODO: The 5-eyes rule is still elusive to me, I only have like 4 eyes.
 tvert eyeO = fv(tvert_177);
 v3 eye_scale = V3(0.8324f, 0.9882f, 0.92f);
 mat4i eyeT = mat4i_translate(eyeO)*mat4i_scales(eye_scale);
 // TODO: Having a mini-coordinate system seems over-engineered to me... but idk man!
 // I think we've managed to dig ourselves out of that situation almost?
 // because we can use eye_in - eye_out to establish a coord frame
 tvert eye_in = (eyeT*fv(tvert_178));
 v1 loomis_eye_inZ = faceZ - loomis_unit/3.f;
 WARN_DELTA(eye_in.z, loomis_eye_inZ, 0.05f);
 
 b32 show_eye_guideline = painter->show_grid;
 if(level1 || show_eye_guideline){
  hl_block;
  if(level1){ draw(bez_line(eye_in, nose_rootL)); }
 }
 tvert eye_out = (eye_in + V3(2.f * eye_in.x+(-0.03f), 0, -0.154f));
 if(level1){ hl_block; draw_line(eye_out, brow_out); }
 tvert es_up_in = (bezier_sample(brow_ridge, 0.3668f));
 Bezier eye_up_line = bez_bezd_old(eye_in, 
                                   V3(0.0814f, 0.3741f, 0.2401f),
                                   V2(0.0159f, 0.3341f),
                                   eye_out);
 fill_point_bez(es_up_in, eye_up_line);
 argb eye_in_shade = painter->shade_color;
 {
  PaintBlock;
  painter->params.fill.color = eye_in_shade;
  fill3(nose_rootL, eye_in, es_up_in);
 }
 //-
 v4 eye_up_line_radii_open;
 v4 eye_up_line_radii_closed;
 v4 eye_low_line_radii_open;
 v4 eye_low_line_radii_closed;
 {// NOTE: Lid radii at eyes open vs closed; the blink shape key blends between them
  // (stroke width changes with the blink, not just the lid shape).
  eye_up_line_radii_open   = V4(0.0137f,  0.6426f, 0.f,     0.4791f);
  eye_up_line_radii_closed = V4(-0.0006f, 0.499f,  0.6154f, 0.17f);
  eye_low_line_radii_open   = eye_up_line_radii_open;
  eye_low_line_radii_closed = eye_up_line_radii_closed;
  eye_low_line_radii_open[1]   = 0.0555f;
  eye_low_line_radii_closed[1] = 0.0555f;
 }
 //-
 Bez eye_low_line = bez_bezd_old(eye_in,
                                 V3(0.1735f, -0.2094f, 0.1663f), 
                                 V2(0.117f, 0.2053f), 
                                 eye_out);
 draw_keyed(Weight_Blink, eye_low_line, eye_low_line,
            eye_low_line_radii_open, eye_low_line_radii_closed);
 {
  tvert eye_low_patch = lerp(eye_in, 0.4768f, cheek_low);
  fill_point_bez(eye_low_patch, eye_low_line);
  fill3(eye_low_patch, eye_out, cheek_low);
  fill3(eye_out, brow_out, es_up_in);
 }
 {// NOTE: Blinking animation control: the closed upper lid IS the lower line, so the
  // blink shape key blends eye_up_line toward eye_low_line (shared endpoints -> the
  // deltas at eye_in/eye_out are zero).
  draw_keyed(Weight_Blink, eye_up_line, eye_low_line,
             eye_up_line_radii_open, eye_up_line_radii_closed);
  {// NOTE: The eyelid
   PaintBlock;
   painter->params.fill.color = eye_in_shade;
   fill_dual_bez_keyed(Weight_Blink, eye_up_line, eye_up_line, eye_up_line, eye_low_line);
  }
 }
 {//~NOTE: Eyeball
  BoneBlock(mk_bone_id(Bone_Eyeball));
  {//-Eyeball visualization
   ShowGroup(Vis_Eyeball);
   hl_block;
   v4 eyeball_radii;
   {
    v1 big   = 0.5f;
    v1 small = 0.25f;
    eyeball_radii = V4(big,small,small,big);
   }
   draw_circle(V3(),{V3z(1)},{1},eyeball_radii);  // NOTE: A prime meridian
   draw_circle(V3(),{V3x(1)},{1},eyeball_radii);
  }
  {//-Iris (featuring Mr. Depth-Offset-Hack)
   PaintBlock;
   painter->params.nslice_per_meter = 128.f*(7.6378f);
   v1 iris_depth_offset = painter->params.fill_depth_offset + 1*centimeter;
   painter->params.line_depth_offset += iris_depth_offset;
   painter->params.fill_depth_offset += iris_depth_offset;
   
   {// NOTE https://blenderartists.org/t/just-how-big-should-the-iris-be-relative-to-the-actual-eyeball/1214393/3
    // iris radius is [0.5, 0.6] that of eyeball
    mat4 irisRelT;
    tdim iris_radius = fv(tdim_179);
    tvert iris_rel_center = mkvert( V3z(square_root(1.f-squared(iris_radius))));
    draw_circle(iris_rel_center, normal_z, iris_radius,
                flp(FUI_Line_Params_180));
   }
  }
  
  {//-NOTE: Checking
   for_i32(index,0,2)
   {
    Bez line = (index==0) ? eye_up_line : eye_low_line;
    Eye_Min_Distance_Result result =
    get_eye_min_distance(eyeball_center, eyeball_radius, line);
    if(result.min_distance < 0)
    {
     DEBUG_VALUE(result.min_distance/millimeter);
     vv0(result.closest_point);
    }
   }
  }
 }
 
 // NOTE: These fills are most dubious...
 fill3(nose_wing, cheek_low, eye_in);
 fill3(nose_root_backL, eye_in, nose_rootL);
 fill3(nose_root_backL, nose_wing, eye_in);
 fill3(eye_out, cheek_up, brow_out);
}
function void
render_grid()
{
 hl_block_color(linear_argb_dark_blue);
 v1 head_unit = 1.f+square_root(2);
 
 b32 camera_frontal = almost_equal(absolute(painter->camera.z.z), 1.f, 1e-2f);
 b32 camera_profile = almost_equal(absolute(painter->camera.z.x), 1.f, 1e-2f);
 
 {//NOTE: Grid lines for the face
  hl_block_color(linear_argb_blue);
  PaintBlock;
  scale_line_radius(0.33f);
  
  v1 face_minY = -2.f*loomis_unit;
  v1 unit = 0.25f * loomis_unit;
  i32 yi_min = (-7);
  i32 yi_max = (8);
  if (camera_frontal)
  {//NOTE: frontal view
   v1 z = faceZ;
   {
    for_i32(xi, 0, 5)
    {//note: Vertical
     v1 x = unit*v1(xi);
     draw_line( V3(x, 1.f, z), V3(x, face_minY, z));
    }
   }
   {
    v1 xmax = 0.9369f;
    for_i32(yi, yi_min, yi_max)
    {//note: Horizontal
     v1 y = unit*v1(yi);
     draw_line( V3(0.f, y, z), V3(xmax, y, z));
    }
   }
  }
  
  if (camera_profile)
  {// NOTE: Profile view
   v1 x = 0.f;
   for_i32(zi, (-11), (2))
   {//NOTE: Vertical
    v1 z = faceZ+unit*v1(zi);
    //draw_line( V3(x,1.f,z), V3(x,face_minY,z));
   }
   for_i32(yi, yi_min, yi_max)
   {//NOTE: Horizontal
    v1 y = unit*v1(yi);
    draw_line(V3(x,y,(-1.8208f)),
              V3(x,y,(1.7172f)));
   }
  }
 }
 
 {//NOTE: Grid lines for the body
  PaintBlock;
  scale_line_radius((0.5f));
  v1 body_minY = 1.f-6*head_unit;
  v1 unit = inv_root2;
  if (camera_frontal)
  {//NOTE: frontal view
   {
    for_i32(xi, 0, 5)
    {//NOTE: Vertical
     v1 x = unit*v1(xi);
     draw_line(V3(x, 1.f, 0.f), V3(x, body_minY, 0.f));
    }
   }
   {
    v1 xmax = (2.8346f);
    for_i32(yi, -20, 4)
    {//NOTE: Horizontal
     v1 y = unit*v1(yi);
     draw_line(V3(0.f, y, 0.f), V3(xmax, y, 0.f));
    }
   }
   
   {//NOTE: Where the shoulder should be
    PaintBlock;
    painter->params.line_color = linear_argb_blue;
    v1 y = (-2.2334f);
    draw_line(V3(0.f, y, 0.f), V3(0.7f*head_unit, y, 0.f));
   }
  }
  
  if (camera_profile)
  {// NOTE: Profile view
   v1 x = 0.f;
   for_i32(xi, -4, 2)
   {//NOTE: Vertical
    v1 z = faceZ+unit*v1(xi);
    draw_line( V3(x,1.f,z), V3(x,body_minY,z));
   }
   for_i32(yi, -20, 4)
   {//NOTE: Horizontal
    v1 y = unit*v1(yi);
    draw_line( V3(x,y,(-1.8208f)),
              V3(x,y,(1.7172f)));
   }
  }
 }
 
 if(fbool(i1_181))
 {//NOTE: Head unit body proportions markers (we've got 6 heads!)
  PaintBlock;
  painter->params.line_color = linear_argb_red;
  if (camera_frontal)
  {//NOTE
   v1 r = 0.5f*head_unit;
   for_i32(yi,-6,1)
   {
    v1 y = 1.f + v1(yi)*head_unit;
    tvert left = mkvert(r,y,0);
    draw_line( V3y(y), left);
   }
  }
  if (camera_profile)
  {//NOTE
   for_i32(yi,-6,1)
   {
    v1 y = 1.f + v1(yi)*head_unit;
    draw_line( V3y(y), V3(0,y,-1.f));
   }
  }
 }
}
function Head
render_head(Pose &pose)
{// NOTE: The ;head + face
 PaintBlock;
 painter->params.nslice_per_meter = 4.1128f * 100.f;
 //lp_block(nslice_per_meter, 4.1128f * 100.f);//NOTE: crank up the lod
 v1 head_unit = 1.f+square_root(2);
 

 mat4i ot = current_world_from_bone();
 
 v1 noseY = -loomis_unit;
 //NOTE: My nose_tip is actually higher than the nose base (the loomis nose y is for the nose base)
 tvert nose_tip = mkvert(0.f, noseY, faceZ) + fv(v3_182);
 ViewCenterBlock(nose_tip);
 
 mat4 &to_local = ot.inverse;
 {// NOTE: profile score
  v3 camera_local = to_local * camera_world_position(painter->camera);
  v3 view_vector = noz(camera_local - nose_tip);
  v1 x = view_vector.z;
  v1 y = view_vector.x;
  v1 phi = arctan2(y,x);
  painter->profile_score = absolute(phi*4.f);
 }
 
 v1 chinY = -2.f*loomis_unit;
 tvert chin_middle = mkvert(0,chinY,faceZ) + fv(v3_183);
 
 v1 face_sideX = inv_root2;
 tvert loomis_side_center = mkvert(V3x(face_sideX));
 tdim loomis_side_radius = {inv_root2};
 tvert ear_center = mkvert(V3x(face_sideX)) + V3(0.0416f, -0.3601f, -0.2332f);
 
 tvert side_circle_center = mkvert(face_sideX,0,0);
 v1 side_circle_radius = loomis_unit;
 
 tvert chinL = mkvert(0,chinY,chin_middle.z) + V3(0.1572f, 0.0504f, -0.077f);
 
 tvert jaw = mkvert(face_sideX, chinY, 0) + V3(-0.0844f, 0.4575f, -0.0247f);
 
 tvert mouth_base = mkvert(0, lerp(chinY, fv(v1_184), noseY), faceZ);
 tvert mouth_corner = mouth_base + V3(0.2499f, 0.f, -0.2801f);
 tvert mouth_cornerR = negateX(mouth_corner);
 
 v1 nose_baseY = noseY;
 
 //-
 v1 nose_wingX = (0.1054f);
 v1 bridgeX = lerp(0.f, 0.284149f, nose_wingX);
 v1 browY = 0.f;
 v1 nose_sideX = (0.0586f);
 //NOTE: nose_rootL is just below the brow
 nose_rootL = mkvert(nose_sideX, 
                     lerp(browY, (0.1534f), noseY), 
                     faceZ+(-0.104f));
 
 nose_wing = mkvert(nose_wingX, nose_baseY, faceZ);
 
 // NOTE: Is this point real? Not really, but it's here to stay.
 tvert nose_wing_up = (nose_wing+V3(-0.011f, 0.1107f, 0.0069f));
 //-
 
 tvert lip_low_center;
 {
  Bezier lip_up;
  Bezier philtrum_line;
  Bezier philtrum_line_mid;
  Bezier lip_low_line;
  v1 philtrumX = 0.0435f;
  b32 nerf_mouth = false;
  PaintBlock;
  scale_line_radius(0.610978f);
  
  tvert philtrum_up = mkvert(0, nose_baseY, faceZ) + V3(0,0,0);
  
  tvert philtrum_low = mouth_base + fv(v3_185);
  philtrum_line_mid = bez_offset(philtrum_up ,
                                 (V3(0.f, -0.1241f, 0.0076f)),
                                 (V3(0.f, 0.0481f, -0.0345f)),
                                 philtrum_low);
  
  philtrum_line = philtrum_line_mid;
  for_i32(index,0,4) { philtrum_line[index].x += philtrumX; }
  
  for_i32(index,0,4) { philtrum_line_mid[index].z -= (0.0065f); }
  
  if(is_left())
  {// NOTE: philtrum
   PaintBlock;
   painter->params.line.alignment_min = (0.8284f);
   draw(philtrum_line, lp(I4(0,0,3,0)));
  }
  
  tvert philtrum_lowL = philtrum_low+V3x(philtrumX);
  lip_up  = bez_v3v3(philtrum_lowL,
                     V3(0.088f, 0.1234f, 0.2037f),
                     V3(-0.0951f, 0.0104f, 0.3071f),
                     mouth_corner);
  {
   PaintBlock;
   if(fv(i1_186)){
    set_line_color_lightness(fv(v1_187));
   }
   tvert lip_in = sety(philtrum_lowL + V3(-0.f, 0.f, -0.0527f),
                       mouth_corner.y+fv(v1_188));
   //NOTE: Main mouth line, looks wicked awesome!
   {//;lip_up_bot
    Line_Params params = lp();
    params.radii = fv(v4_189);
    if(fv(i1_190)){
     params.lightness_additions = fv(v4_191);
    }
    Bezier lip_up_bot = bez_unit2(lip_in,
                                  fv(v4_192),
                                  V3(0.f, 0.2748f, 0.9615f),
                                  mouth_corner);
    draw(lip_up_bot, params);
   }
  }
  {
   //NOTE: Upper lip is smaller than lower lip
   lip_low_center = mouth_base + (V3(0.f, -0.088f, -0.0133f));
   lip_low_line = bez_unit2(lip_low_center,
                            V4(0.f, 1.0473f, 0.f, -0.7242f),
                            V3(0.f, -0.1848f, 0.9828f),
                            mouth_corner);
   if(!nerf_mouth)
   {// NOTE This combines with @lip_up_bot to create the center part of the mouth.
    // We must keep it centralized
    Line_Params params = lp();
    params.radii = V4(0.7f, -0.2807f, 0.f, 0.f);
    params.lightness_additions = fv(v4_193);
    if(level1){params.radii = painter->params.line.radii;}
    draw(lip_low_line,params);
   }
  }
  
  tvert philtrum_offset_point = (nose_wing+(V3(-0.0499f, -0.0725f, -0.0489f)));
  fill_point_bez(philtrum_offset_point, lip_up);
  fill_point_bez(philtrum_offset_point, philtrum_line_mid);
  fill3(philtrum_offset_point, nose_wing, philtrum_up+V3x(philtrumX));
  fill3(philtrum_offset_point, mouth_corner, nose_wing);
  
  fill3(philtrum_lowL,philtrum_low,philtrum_offset_point);;
 }
 
 //-NOTE: Nose
 // NOTE: nose_tip is the apex of the tip curve below (t=0.5 of a cubic whose controls
 // are p0+c / p3+negateX(c) = base + 0.75*c.yz); everything else (side line, fills,
 // under-line, tip curve endpoints) hangs off nose_tip_base, 0.75*c.yz behind it.
 tvec nose_tip_control = V3(-0.0533f, 0.0283f, 0.0438f);
 tvert nose_tip_base = nose_tip - 0.75f*V3(0.f, nose_tip_control.y, nose_tip_control.z);
 tvert nose_tipL = (nose_tip_base+V3x(nose_sideX));
 tvert v1219 = nose_tipL;
 Bez nose_line_side = bez_unit2(nose_rootL,
                                V4(),
                                V3(0.f, 0.f, 1.f),
                                v1219);
 // NOTE(kv) The nose lines/fills below this point live in the document
 // (game/driver/driver.document.ad, tag Vis_Nose) -- replayed, not drawn here.
 // Re-draw + `export_group Vis_Nose` to change them (plan-data-only-region-poc).

 //~NOTE: Cheek situation pretty complex!
 cheek_low = mkvert(0,noseY,faceZ) + V3(0.6062f, 0.f, -0.4289f);
 
 //TODO(kv) Adjust the jaw value here
 fill4(jaw, chinL, mouth_corner, cheek_low);
 
 nose_root_backL = fv(tvert_194) + V3x(nose_sideX);
 
 brow_out = fv(tvert_195);
 cheek_up = (brow_out+V3(0.f, -0.2935f, 0.f));
 if(level1){
  hl_block;
  draw_line(brow_out, cheek_up);  //NOTE: Literally a straight line
 }
 
 // NOTE: brow_ridge is the neutral bone structure of the brow, as well as the eye socket
 // NOTE: I have few ideas what its shape should be, also very hard to draw right
 brow_ridge = bez_unit2(nose_rootL,
                        V4(0.f, 0.3208f, 0.f, 0.6236f),
                        V3(0.f, 0.6019f, 0.7986f),
                        brow_out);
 if(level1){ hl_block; draw(brow_ridge); }
 
 {//-NOTE: Eyebrows
  PaintBlock;
  scale_line_radius(0.8053f);
  tvert brow_in = (bezier_sample(brow_ridge, 0.1313f) +
                   V3(0.0044f, -0.0566f, 0.0056f));
  //NOTE: brow_mid is a really fuzzy point!
  tvert brow_mid = (bezier_sample(brow_ridge, (0.593f)) + 
                    V3(-0.0006f, 0.0008f, 0.0086f));
  
  Bezier brow_in_line = bez_line(brow_in, brow_mid);
  v1 brow_joint_radius;
  {
   v4 radii = V4(0.3344f, 0.6654f, 0.61f, 1.f);
   brow_joint_radius = radii.v[3];
   draw(brow_in_line, radii);
  }
  {
   Bezier brow_out_line = bez_unit(brow_mid, (V2(0.f, 0.5549f)), (V2(0.f, 0.4409f)), V3(0.f, 1.f, 0.f), brow_out);
   v4 radii = V4(0.25f, 0.8f, 0.8f, 0.25f);
   radii.v[0] = brow_joint_radius;
   draw(brow_out_line, radii);
  }
 }
 
 {
  tvert cj = (lerp(chinL, 0.5f, jaw));
  {// TODO: This line (and "cj") is here because it happens to look good
   fcurve(Curve_4, ear_center, cj);
  }
 }
 
 fill3(nose_wing, mouth_corner, cheek_low);
 
 // TODO(kv): Extreme hackiness, maybe we could replace bezier_poly
 {
  Bezier line = bez_line( nose_root_backL, nose_wing);
  fill_dual_bez( nose_line_side, line);
 }
 
 tvert foreheadL = (brow_out + V3(0.0477f, 0.7772f, -0.0232f));
 v1 foreheadY = foreheadL.y;
 
 {
  tvert verts[] = {jaw, cheek_up, brow_out, foreheadL};
  fill_fan(ear_center, verts, alen(verts));
 }
 
 fill3(cheek_up,jaw,cheek_low);
 
 if (level1)
 {
  hl_block;
  draw(bez_line(brow_out, cheek_up));
 }
 
 {//-;Ear
  PaintBlock;
  set_line_color_lightness(fv(v1_196));
  scale_line_radius(0.5f);
  tvert ear_back = ear_center + fv(v3_197);
  tvert ear_low = ear_center + fv(v3_198);
  v4 radii1 = fv(v4_199);
  v4 radii2 = radii_c2(radii1, V2(-0.9383f, 0.f));
  Bez ear1 = bez_unit(ear_center,
                      V2(0.2792f, 3.5588f),
                      V2(0.1526f, 0.3068f),
                      V3(0.3587f, 0.692f, -0.6264f),
                      ear_back);
  draw(ear1, lp(radii1));
  Bez ear2 = bez_c2(ear1, V3(), ear_low);
  draw(ear2, lp(radii2));
 }
 
 //-NOTE: The incredibly non-thrilling story of the head
 tvert head_back_out = fv(tvert_200);
 Bezier head_top_out_line = bez_offset(foreheadL,
                                       V3(0.1239f, 0.1894f, -0.2995f),
                                       V3(-0.0634f, 0.3622f, 0.1935f),
                                       head_back_out);
 if(level1){
  draw(head_top_out_line);
 }
 tvert forehead_in = mkverty(foreheadY) + V3(0.1445f, 0.072f, 0.8969f);
 
 Bezier hair_hline = bez_raw(foreheadL,
                             forehead_in,
                             negateX(forehead_in),
                             negateX(foreheadL));
 if(is_left()){
  if(level1){ draw(hair_hline); }
 }
 
 tvert head_back_in = fv(tvert_201);
 Bezier head_top_in_line = bez_bezd_old(forehead_in,
                                        V3(0.f, 0.4276f, -0.1837f),
                                        V2(0.3589f, 0.1402f),
                                        head_back_in);
 if(level2){
  draw(head_top_in_line);
 }
 fill_patch( patch_symx(head_top_out_line, head_top_in_line));
 
 tvert behind_ear = (ear_center + (V3(-0.183f, -0.3342f, -0.1239f)));
 Bezier head_back_out_line;
 {
  //TODO: omg why did you make it so confusing bro?
  head_back_out_line = bez_offset(head_back_out,
                                  (V3(0.f, 0.001f, -0.0779f)),
                                  (V3(-0.0535f, 0.197f, -0.6398f)),
                                  behind_ear);
  if (level2) { draw(head_back_out_line); }
  tvert head_back_in2 = fv(tvert_202);//note: Notice the loomis side circle
  
  Bezier head_back_in_line = bez_offset(head_back_in,
                                        (V3(-0.f, -0.3664f, -0.3108f)),
                                        (V3(0.f, -0.4228f, -1.1179f)),
                                        head_back_in2);
  
  Patch head_back = patch_symx(head_back_out_line, head_back_in_line);
  if (level2) { draw(head_back_in_line); }
  fill_patch( head_back);
  
  {//NOTE: draw vertical line
   PaintBlock;
   painter->params.line.alignment_min = (0.9797f);
   draw(get_uline(head_back, 0.5f), lp(I4(1,3,3,0)));
  }
 }
 
 fill_point_bez(ear_center, head_top_out_line);
 fill_line_bez(ear_center, head_back_out, head_back_out_line);
 
 if(fbool(i1_203))
 {//NOTE The forehead
  tvert hair_hline_center = bezier_sample(hair_hline, 0.5f);
  tvert esuo = brow_out;
  tvert control_point = mkvert(fv(tdim_204), -esuo.y/3.f, (4.f-esuo.z)/3.f);
  // NOTE This line goes through the cross center!
  Bez brow_hline = bez_raw(esuo,
                           control_point,
                           negateX(control_point),
                           negateX(esuo));
  if(is_left()){
   fill_patch( brow_hline,  brow_hline,  hair_hline, hair_hline);
  }
 }
 
 {
  //~NOTE: Chin
  tvert chin_up_center = chinL + (V3(-0.1993f, 0.0993f, 0.0805f));
  tvert chin_upL = chin_up_center + V3x(0.1274f);
  tvert chin_upR = negateX(chin_upL);
  tvert chinR = negateX(chinL);
  if(is_left())
  {
   if(fbool(i1_205))
   {
    Bezier chin_line = bez_raw(chinL, chin_middle, chin_middle, negateX(chinL));
    draw(chin_line);
   }
  }
  
  {//NOTE: chin fixes
   PaintBlock;
   scale_line_radius(0.25f);
   tvert mouth_low_valley = lip_low_center+fv(v3_206);
   {
    ShowIf(is_left());
    ShowAlignedSymIf(V3x(1.f), cosine(0.25f*0.73f));
    {
     Line_Params params = lp();
     params.lightness_additions = fv(v4_207);
     draw(bez_line(lip_low_center, mouth_low_valley), params);
    }
    {
     draw(bez_line(chin_middle, setx(chin_upL, 0.f)));
    }
    if(level1){
     draw(bez_line(mouth_low_valley,chin_middle));
    }
   }
   // so we want to interpolate valley_under_lip
   tvert chin_point0 = mouth_corner;
   tvert control_point = mkvert(0.f, 
                                (-chin_point0.y + 4*mouth_low_valley.y)/3.f,
                                (-chin_point0.z + 4*mouth_low_valley.z)/3.f);
   Bez mouth_low_valley_line = bez_raw(chin_point0,
                                       control_point,
                                       negateX(control_point),
                                       negateX(chin_point0));
   if(level1){
    draw(mouth_low_valley_line);
   }
   
   fill3(lip_low_center,mouth_corner,mouth_low_valley);
   fill4(chin_middle, chinL, mouth_corner, mouth_low_valley);
  }
 }
 
 tvert head_neck_junction = fv(tvert_208);
 if(is_left())
 {
  {
   ShowAlignedSymIf(V3x(1.f), fv(v1_209));
   draw(bez_line(chin_middle, head_neck_junction));
  }
  fill3(head_neck_junction, chinL, jaw);
  fill3(head_neck_junction, chinL, negateX(chinL));
 }
 
 {// NOTE: Some cheek line
  PaintBlock;
  scale_line_radius(0.3826f);
  set_line_color_lightness(1.5096f);
  tvert a1626 = fv(tvert_210);
  tvert b1627 = fv(tvert_211);
  tvert c1633 = fv(tvert_212);
 }
 
 {//~NOTE: Hair omg
  PaintBlock;
  painter->params.nslice_per_meter = 1.5162f*128.f;
  scale_line_radius(0.5489f);
  //NOTE: Fine tip hair -> thicker, more even radius
  painter->params.line.radii = V4(0.5f, 1.f, 1.f, 0.25f);
  
  v1 hairY = loomis_unit;
  tvert hair_root = fv(tvert_213);  //NOTE: the point on top of the head, literally the highest point
  tvert bang_root = bezier_sample(hair_hline, 0.5f);
  
  v1 flutter_period = 2.75f;
  b32 should_flutter;
  v1 time;
  {
   v1 time0 = painter->anim_time / flutter_period;
   should_flutter = (i32(time0) % 2 == 0);
   time = cycle01_positive(time0);
  }
  Animation_Old ani_value; auto ani = &ani_value;
  {
   begin_animation(ani);
#define Group(...)  add_frame_group(ani, __VA_ARGS__)
   {
    Group(1.f, V4(0.f, -0.304f, 0.f, 1.2f));
    Group(1.f, V4(1.2f, 0.f, 0.f, 1.2f));
    Group(1.f, V4(0.5752f, -0.2f, 0.2f, 1.f));
    Group(0.5f, V4(1.2f, 0.f, 0.f, 1.2f));
    Group(1.f, V4(0.2176f, -0.4755f, 0.2169f, 0.f));
   }
#undef Group
   end_animation(ani);
  }
  v1 thair = 0.f;
  if(should_flutter){
   if(is_right()){
    thair = get_animation_value(ani, time+0.06f);
   }else{
    thair = get_animation_value(ani, time);
   }
  }
  tvert bang_midpoint = fv(tvert_214);
  if(is_left())
  {
   Bezier bang_vline = bez_unit2(bang_root,
                                 V4(0.f, 0.2629f, 0.1602f, 0.3068f),
                                 V3(0.f, 0.f, 1.f),
                                 bang_midpoint);
   PaintBlock;
   painter->params.line.alignment_min = cosine(0.25f*0.4036f);
   draw(bang_vline);
  }
  tvert bang_tip;
  {
   tvec c = fv(tvert_215);
   bang_tip = fv(tvert_216)+thair*c;
  }
  Bez bang_vline2 = bez_bezd_old(bang_root, 
                                 V3(0.3419f, 0.0757f, 0.129f),
                                 V2(0.1345f, 0.1639f),
                                 bang_tip);
  {
   tvec a = V3(0.0172f, -0.0113f, -0.0825f);
   tvec b = V3(-0.0664f, 0.0812f, 0.0059f);
   bang_vline2[1] += thair*a;
   bang_vline2[2] += thair*b;
  }
  Bez bang_hline = bez_offset(bang_midpoint,
                              fv(v3_217),
                              fv(v3_218),
                              bang_tip);
  {
   tvec a = V3(0.0000f, -0.1217f, 0.0000f);
   tvec b = V3(0.0467f, 0.0385f, 0.0000f);
   bang_hline[1] += thair*b;
   bang_hline[2] += thair*a;
  }
  
  draw(bang_vline2);
  draw(bang_hline, (0.5176f) * painter->params.line.radii);
  
  //-NOTE: The bang saga is over, let's move onto something else
  tvert hair_main_tip = fv(tvert_219);
  Bez vline = bez_bezd_old(hair_root,
                           V3(0.1414f, 0.2764f, -0.471f),
                           V2(0.3956f, 0.3102f),
                           hair_main_tip);
  
  draw(vline, fv(v4_220));
  
  if(is_left()){
   tvec hcontrol = V3(0.1291f, -0.0058f, -0.2506f);
   Bez connecting = bez_offset(hair_main_tip,
                               hcontrol,
                               negateX(hcontrol),
                               negateX(hair_main_tip));
   draw(connecting, I4_sym(fv(i2_221)));
  }
  
  Bezier hairline_side = bez_offset(bang_root,
                                    V3(0.5271f, -0.0051f, 0.0478f),
                                    V3(0.0671f, 0.1143f, 0.3924f),
                                    ear_center);
  draw(hairline_side); 
  
  {
   // NOTE: Some hair outline so it looks good at the front
   Bez over1 = bez_bezd_old(hair_root,
                            V3(0.5313f, 0.0177f, 0.1293f),
                            V2(0.1839f, 0.232f),
                            bezier_sample(hairline_side, (0.3991f)));
   Bez over2 = bez_bezd_old(hair_root,
                            V3(0.3694f, 0.2549f, -0.0512f),
                            V2(0.0175f, 0.2904f),
                            ear_center);
   draw(over1);
   {
    PaintBlock;
    painter->params.line.alignment_min = (0.4764f);
    draw(over2);
   }
  }
  if(is_left())
  {
   Bez line = bez_unit2(hair_root,
                        V4(0.f, 0.2255f, 0.3279f, 0.2047f),
                        (V3(0.f, 1.f, 0.f)),
                        bang_root);
   draw(line);
  }
 }
 
 if(painter->show_grid and is_left())
 {//~NOTE: Proportions diagram
  render_grid();
 }
 
 if(is_left())
 {//~NOTE: Loomis ball
  ShowGroup(Vis_Loomis_Ball);
  PaintBlock;
  hl_block_color(linear_argb_dark_blue);
  //NOTE: The face
  if(painter->show_grid){ painter->params.line_color = linear_argb_silver; }
  {// NOTE: Loomis The side circle
   draw_circle(loomis_side_center, normal_x, loomis_side_radius);
  }
  {
   // NOTE: Face z
   //draw(bez_line(V3z(faceZ), setz(chin_middle, faceZ)));
   draw_circle(V3(), normal_z, {1});  // NOTE: The Loomis "unit circle" (i.e the first circle you draw)
   draw_circle(V3(), normal_y, {1});  // equator
   draw_circle(V3(), normal_x, {1});  // longitude
  }
 }
 
 Head head_obj;
 {//~NOTE: Export head
  // TODO: Maybe analytically define this point on the skull?
  tvert trapezius_head = (mkvert(0, noseY, head_back_out.z) + 
                          V3(0.2824f, 0.0086f, -0.323f));
#define head_export(vertex)  head_obj.vertex = vertex;
  macro_head(head_export);
#undef head_export
 }
 return head_obj;
}
function void
render_character(Pose &pose)
{//~ IMPORTANT: Conventions
 // 1: Things are on the left (side of the face) by default. Meaning x>0.
 painter->shade_color = compute_fill_color(0.094014f);
 if(fbool(i1_222)){painter->shade_color = painter->params.fill.color;}
 v1 arm_ry = head_unit_world*(0.5302f);
 macro_torso(macro_world_declare);
 b32 right_only = fv(i1_223);  // NOTE To spot overdraw
 for_i32(lr_index,0,2)
 {//~NOTE: Torso
  if(right_only and lr_index == 0){
   continue;
  }
  
  SetInBlock(the_model->is_right, lr_index);
  Head head;
  {
   BoneBlock(mk_bone_id(Bone_Head));
   head = render_head(pose);
   render_eyes(pose);
  }
  Pelvis pelvis_obj;
  {
   BoneBlock(mk_bone_id(Bone_Pelvis));
   pelvis_obj = render_pelvis();
  }
  
  BoneBlock(mk_bone_id(Bone_Torso));
  Torso torso_obj = render_torso(pose, pelvis_obj, head);
  tvert elbow_up_out = forearm_rotation_pivot + fv(v3_224);
  {
   BoneBlock(mk_bone_id(Bone_Arm));
   Arm arm_obj = render_arm(pose, torso_obj, elbow_up_out);
   {
    BoneBlock(mk_bone_id(Bone_Forearm));
    Forearm forearm_obj = render_forearm(arm_obj, elbow_up_out);
    {
     BoneBlock(mk_bone_id(Bone_Hand));
     render_hand(forearm_obj);
    }
   }
  }
 }
}
function void
show_reference_images()
{
 b32 full_alpha = painter->references_full_alpha;
 BoneBlock(Bone_References);
 Reference_Preset reference_preset = get_reference_preset();
 if(reference_preset != 0)
 {//-New reference preset path
  Reference_Preset_Data data = driver_get_reference_preset_data(reference_preset);
  draw_reference_image_from_data(data.image);
 }
 else
 {//-Old render preset path
  Preset_Settings &settings = active_preset_settings();
  {// NOTE: The #ReferenceImage experience
   if(camera_is_right())
   {
    ShowGroup(Vis_Ref_Arm_Medial_Right);
    tvert center = fv(tvert_225);
    v1 width = 0.7966f;
    Stringz filename = fimage(strlit("G:/My Drive/Art/arm medial.jpg"));
    draw_image(filename, center, V3z(width), V3y(1.f),
               0.5f);
   }
   if(camera_is_front())
   {
    Reference_Image references[] =
    {
     {// NOTE: full-body MM skeleton
      .filename  = fimage(image_skeletal_meat_outline),
      .center    = fv(tvert_226),
      .x_axis     = V3x(1.8194f),
      .alpha     = 0.3033f,
     },
     {// NOTE: full-body MM diagram
      .filename  = fimage(image_mm_full_body_muslce_front),
      .center    = fv(tvert_227),
      .x_axis     = V3x(1.8695f),
      .alpha     = 0.3033f,
     },
     {
      .filename  = fimage(strlit("G:/My Drive/Art/AM arm front.JPG")),
      .center    = fv(tvert_228),
      .x_axis     = V3x(-1.3938f),
      .alpha     = 0.1421f,
     },
     {
      .filename  = fimage(strlit("G:/My Drive/Art/loomis 6 heads.JPG")),
      .center    = fv(tvert_229),
      .x_axis    = V3x(-1.0668f),
      .alpha     = 0.1421f,
     },
     {
      .filename = fimage(strlit("G:/My Drive/Art/hpc.JPG")),
      .center   = fv(tvert_230),
      .x_axis   = V3x(2.6661f),
      .alpha    = 0.4221f,
     },
    };
    
    for_i32(ref_index, 0, alen(references))
    {// NOTE(kv) Every front reference is emitted+tagged; the active row's
     // reference_image selects which one is live via vis_live (all others hidden).
     ShowGroup(cast(Group_Vis)(Vis_Ref_Front_0 + ref_index));
     draw_reference_image_from_data(references[ref_index]);
    }
   }
   
   if(camera_is_back())
   {// NOTE ;back_reference @armT
    ShowGroup(Vis_Ref_Arm_Back_Bone);
    {
     tvert center = fv(tvert_231);
     v1 width  = 2.4645f;
     Stringz filename = file_arm_back_bone;
     draw_image(filename, center, V3x(-width), V3y(1.f),
                0.3033f);
    }
   }
   if(camera_is_left())
   {
    ShowGroup(Vis_Ref_Arm_Profile_Left);
    {
     tvert center = fv(tvert_232);
     v1 width  = 1.1454f;
     Stringz filename = fimage(image_arm_profile_full);
     v3 x = V3z(1);
     v1 alpha = 0.299f;
     if(full_alpha){ alpha = 1.f; }
     //NOTE: The hand is too long in this one
     draw_image(filename, center, -width*x, V3y(1.f), alpha);
    }
   }
  }
 }
}
//~
function void
driver_render(Arena *tmp, Painter *painter0)
{// NOTE @driver_api, see also @call_driver_render
 painter = painter0;
 
 //-Animate once per viewport
 Pose pose = driver_animate(painter->anim_time);
 compute_bones_from_pose(pose);
 publish_weight(Weight_Blink, pose.tblink);
 
 Preset_Settings &preset_settings = active_preset_settings();
 i32 viz_level = preset_settings.viz_level;
 
 u64 start_cycle = __rdtsc();
 bs_cycle_counter = 0;
 //f64 start_time  = gb_time_now();
 
 // NOTE(kv) default_fill/default_line_color are viz-level-independent: painter is
 // zero-init here, so `level1` always read false at this point (Q1, preset-followups).
 argb default_fill = painter->background_color;

 v1 default_line_radius_min = 0.5089f;
 v1 default_line_end_radius = default_line_radius_min;
 if(fbool(i1_233)){
  default_line_end_radius = i2f6(2);
 }
 {//~ ;init_painter_2
  Painter *p = painter;
  p->params.painting = true;
  {
   Paint_Params &pp = painter->params;
   pp.fill_depth_offset = millimeter * 1.f;
   pp.radius_mult      = 1.f;
   pp.nslice_per_meter = fv(v1_234) * 100.f;
   pp.fill.color = default_fill;
   pp.line.radii = V4(default_line_radius_min, 
                      1.f,
                      i2f6(5),
                      default_line_end_radius);
   
   //argb default_line_color = argb_gray(srgb_to_linear1(0.3389f));
   // ;default_line_color
   argb default_line_color = argb_gray(fv(v1_235));
   pp.line_color = default_line_color;
  }
  p->viz_level            = viz_level;
  p->ignore_radii         = preset_settings.ignore_radii;
  p->ignore_alignment_min = preset_settings.ignore_alignment_min;
 }
 
 render_character(pose);
 
 {
  //f64 end_time  = gb_time_now();
  //f32 time_taken = f32(end_time - start_time);
  //DEBUG_VALUE( time_taken );
  u64 end_cycle = __rdtsc();
  painter->render_cycles = u32(end_cycle - start_cycle);
 }
 
 show_reference_images();
 
 if(fbool(i1_236))
 {// NOTE Test rotation, again
  BoneBlock(mk_bone_id(Bone_References));
  hl_block_color(linear_argb_blue);
  
  tvert a = mkvert(0,0,0);
  tvert b = mkvert(1,0,0);
  tvert c = mkvert(0,.5f,0);
  
  {
   draw(bez_line(a,b));
   draw(bez_line(a,c));
  }
  
  tvert pivot;
  {//-NOTE The meat
   tvert translate = mkvert(1,1,0);
   mat4i rotate = mat4i_rotate_tpr(0,0, painter->looping_time);
   v1 scale = 2.f;
   pivot = fv(tvert_237);
   vv0_overlay(pivot);
   // trs_pivot_transform
   mat4i translate_scale = mat4i_translate(translate) * mat4i_scale(scale);
   mat4i mom_from_kid = (mat4i_translate(pivot)
                         * rotate
                         * translate_scale
                         * mat4i_translate(-pivot)
                         );
   make_bone(mk_bone_id(Bone_Test), mom_from_kid);
  }
  
  {
   hl_block_color(argb_black);
   BoneBlock(Bone_Test);
   vv0_overlay(pivot);
   draw(bez_line(a,b));
   draw(bez_line(a,c));
  }
 }
 
 //-
 painter = 0;
}
#undef X_comma_list
//~EOF
