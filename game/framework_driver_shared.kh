//-NOTE See also "framework_driver_shared.h"
[info] typedef u32 argb;
[info] typedef i1  b32;

[info]
enum Bone_Type
{
 Bone_Invalid        = -1,
 Bone_None           = 0,
 Bone_Head           = 1,
 Bone_Arm            = 2,
 Bone_Forearm        = 3,
 Bone_Bottom_Phalanx = 4,
 Bone_Mid_Phalanx    = 5,
 Bone_Top_Phalanx    = 6,
 Bone_Torso          = 7,
 Bone_References     = 8,
 Bone_Hand           = 9,
 Bone_Thumb          = 10,
 Bone_Pelvis         = 11,
 Bone_Eyeball        = 12,
 Bone_Test           = 13,
 Bone_Camera         = 14,
};
// TODO(kv) Enums are 4 bytes by default, and we don't really want that!
[info]
struct Bone_ID
{
 Bone_Type type;
 i32       id;
};
// NOTE Bone_ID must precede the wrapper_type lines: tvert embeds a Bone_ID.

[info] wrapper_type v1 tdim(constructor=mkdim);
[info] wrapper_type v3 tvert(constructor=mkvert);
[info] wrapper_type v3 tnormal(constructor=mk_normal);
// NOTE(kv) We just leave @tvec as @v3
// then other types just have to wrap v3, if they don't wanna be vector...
// it's kinda weird, but what are you gonna do?

[info]
typedef u32 Line_Flags;
enum{
 Line_Overlay   = 0x1,
 Line_Straight  = 0x2,
 Line_No_SymX   = 0x4,
 Line_Invisible = 0x8,
};

[info]
typedef u32 FLP_Flags;
enum{
};

//-NOTE(kv) Structs moved here from framework_driver_shared.h on 2026-09-12
// (plan-document-self-describing-format step 4) so Type_Info covers everything the
// document file holds. Helpers/operators stay in the .h; `no_parse { }` blocks are
// echoed verbatim (operators only, never data members).

[info embed]
struct Camera_Data
{
 // NOTE(kv) Our spherical coordinates convention is kind of like
 // the physics convention https://en.wikipedia.org/wiki/Spherical_coordinate_system
 // The similarity is that phi is the rotation in xy plane,
 // and theta is the angle to z axis.
 // But we interpret the numbers differently, view @setup_camera for details.
 v1 distance;
 v1 theta;
 v1 phi;
 v1 roll;
 v3 pivot;
};

[info]
struct Fill_Flags
{// NOTE(kv) Bits: Fill_Flag enum in the .h (Fill_Culled, Fill_Inverted, Fill_Overlay).
 u32 v;
};
[info]
struct Fill_Params
{
 // NOTE(kv) Singular color fills still makes sense for debugging/highlighting.
 argb color;
 Fill_Flags flags;
};
[info]
struct Line_Params
{
 v4 radii;
 // NOTE(kv) I want lightness changes to adapt to line color.
 // so we store the "x" in "rgb + x*rgb".
 v4 lightness_additions;
 Line_Flags flags;

 // NOTE(kv) Most of the time we can specify normal-alignment by group,
 // but sometimes we want to infer the view vector automatically from the curve.
 v1 alignment_min;
};
[info]
struct Paint_Params
{// NOTE(kv) The PaintFieldList X-macro in the .h mirrors these members -- extend BOTH.
 // NOTE(kv) "painting" is used f.ex for alignment checks,
 // it MUST NOT disable sending data, because cursor selection still needs them.
 b32 painting;

 Line_Params line;
 Fill_Params fill;

 v1 radius_mult;
 v1 nslice_per_meter;
 argb line_color;
 v1 line_depth_offset;
 v1 fill_depth_offset;
};

[info]
struct Bezier
{
 tvert e[4];
 no_parse {
  myinline operator tvert *(){ return e; };
  myinline tvert &operator[](i32 index){ return e[index]; }
 }
};
[info]
struct Patch
{
 tvert e[4][4];
 no_parse {
  typedef tvert Array4x4[4][4];  // #stroustrup
  operator Array4x4&() { return e; }
 }
};

[info]
struct Range_i16
{// NOTE(kv) Was union{min,begin}/union{max,end}; the begin/end aliases had no users.
 i16 min;
 i16 max;
};
[info]
struct FUI_File
{
 i16 is_driver;
 i16 index;
};
[info]
struct Location
{// NOTE(kv) Code range a primitive/group came from; helpers + the document sentinel
 // (Location_File_Document) live in the .h. Never serialized (meta_unserialized at the
 // holders), but Type_Info still needs the type.
 FUI_File file;
 Range_i16 range;
};

[info]
struct FUI_Line_Params
{// Mirrors @Line_Params
 FLP_Flags fui_flags;
 //-
 v4 radii;
 v4 lightness_additions;
 
 Line_Flags line_flags;
};

[info]
struct Reference_Placement
{// Where a @Reference_Image sits in the world, as one draggable object: center is the
 // quad's midpoint, x_axis its half-width vector (length = size, sign = mirror), and the
 // up direction is world-y. center first: member 0 is the default active member.
 // NOTE center is v3, not tvert: the metaprogram doesn't emit read_binary for
 // wrapper_types, so an [info] struct can't hold one.
 v3 center;
 v3 x_axis;
 v1 alpha;
};

[info]
struct Curve
{// One stroke as data (@fcurve): the shape as @bez_offset control offsets from the
 // code-side anchors (p1 = p0+d0, p2 = p3+d3), then the line params (mirrors
 // @FUI_Line_Params). d0 first: member 0 is the default active member on activation.
 v3 d0;
 v3 d3;
 //-
 v4 radii;
 v4 lightness_additions;

 Line_Flags line_flags;
 FLP_Flags fui_flags;
};

[info]
// NOTE(kv) A "reference scene" = compiled-in reference image + placement + camera + pose
// (driver_get_scene_data). A preset (Preset_Settings row) points at one scene or none.
// Was `Reference_Preset` until plan-settings-ui (2026-09-06).
enum Reference_Scene
{
 Scene_None = 0,
 Scene_Back = 1,
 Scene_Arm_Profile = 2,
 Scene_Eco_Skeleton = 3,
 Scene_Head_Profile = 4,
};
[info]
// NOTE(kv) Global reference-image visibility (state.txt; Q cycles it).
enum Reference_Mode
{
 Reference_Off   = 0,  // draw no reference images at all
 Reference_Alpha = 1,  // each image at its own placement alpha
 Reference_Full  = 2,  // every image opaque
};
//~Framework api
api_table framework_api_1
{
 void poly3_inner(Poly3 points, argb c0, argb c1, argb c2, Poly_Flags flags);
 void draw_bezier_inner(tvert P[4], Line_Params &params, argb base_color);
}
meta_table(name) framework_api_2
{
 push_object_transform_to_target,
 DEBUG_send_entry,
 push_image,
}

generate
{
 gen_for(framework_api_1)
 {
#define `(name)__return `return
#define `(name)__params `params
  
 }
 
#define framework_api_xlist_1(X) \
gen_for(framework_api_1)
 {
  X(`name) \
 }
 
#define framework_api_xlist_2(X) \
gen_for(framework_api_2)
 {
  X(`name) \
 }
 
#define framework_api_xlist(X) \
framework_api_xlist_1(X) \
framework_api_xlist_2(X) \
memory_functions_xlist(X)
}

struct Reference_Image
{
 Stringz filename;
 Reference_Placement placement;
};
struct Reference_Scene_Data
{
 // NOTE @Camera_Data
 v1 camera_phi2;
 v1 camera_theta2;
 Reference_Image image;
 Pose pose;
};

api_table driver_api
{
 void driver_render(Arena *arena, Painter *painter);
 void driver_update(Model *model, v1 anim_time);
 void driver_shutdown(void);
 void driver_update_tweaks();
 Reference_Scene_Data driver_get_scene_data(Reference_Scene scene);
}

generate
{
 gen_for(driver_api)
 {
#define `(name)__return `return
#define `(name)__params `params
  
 }
 
#define driver_api_xlist(X) \
gen_for(driver_api)
 {
  X(`name) \
 }
}

[info]
// NOTE(kv) One preset ("draw preset") = a named bundle of small display settings over
// the ONE model (Q57/Q61, plan-settings-ui). Live rows sit in Model_Recordings (shared
// across TUs, survives clear_model); seeded by seed_preset_settings, persisted as text
// in data/state.txt (plan-presets-text-file). Every b32 member is a panel checkbox and
// a channel `toggle` target for free; zero members are omitted from the file.
struct Preset_Settings
{
 char name[PRESET_NAME_CAP];
 i32 viz_level;             // 0/1/2
 i32 reference_image;       // front-camera reference selector: -1 = none, else ref-table index
 Reference_Scene scene;     // compiled-in image+camera+pose bundle, Scene_None = none
 //-Display
 b32 show_eyeball;
 b32 show_loomis_ball;
 b32 show_grid;
 b32 hide_hair;             // inverted so zero (= every existing preset) keeps the hair
 b32 ignore_radii;
 b32 ignore_alignment_min;
 //-Reference images (side cameras)
 b32 show_arm_medial_right; // right-camera reference image
 b32 show_arm_back_bone;    // back-camera reference image
 b32 show_arm_profile_left; // left-camera reference image
 //-Picking
 b32 fill_only_picking;     // mouse-pick tests fills only, skipping curve vertices
};

[info embed]
struct Saved_Viewport
{
 Camera_Data target_camera;
 i32 preset;
 i32 last_preset;
};
//-